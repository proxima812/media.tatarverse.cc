---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { config } from "main.config";
import CardLogo from "@/components/Catalog/CardLogo.astro";
import SaveButton from "@/components/Catalog/SaveButton.astro";
import Button from "@/components/ui/Button.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";
import { categoryTone } from "@/lib/taxonomy";
import { meshGradient } from "@/lib/ui/meshGradient";
import { TONE_CLASSES } from "@/lib/ui/tone";
import { cn } from "cn";

interface Props {
	card: CollectionEntry<"cards">;
	locale: LocaleCode;
}

const { card, locale } = Astro.props;
const { name, description, facts, url, logo, peoples, pubDate, categories } =
	card.data;
const t = useTranslations(locale);

/*
 * Домен стоит на самой кнопке: человек уходит на чужой сайт и имеет право
 * видеть куда - подпись «Перейти на проект» этого не говорила.
 */
const host = new URL(url).hostname.replace(/^www\./, "");

const dateLabel = new Intl.DateTimeFormat(locale, {
	day: "numeric",
	month: "long",
	year: "numeric",
}).format(pubDate);

/** `datetime` у `<time>`: «29 августа 2026 г.» машина не разбирает. */
const dateValue = pubDate.toISOString().slice(0, 10);

/*
 * Обложка над заголовком - тот же детерминированный мэш по имени карточки,
 * что на обложке в рядах и в сетке каталога, только шире. Гость из поиска,
 * перешедший с карточки, узнает проект по тому же пятну цвета. Градиент
 * берется по имени, а не из логотипа, - тогда он у проекта один везде.
 */
const cover = meshGradient(name);

/*
 * Точки фактов - в тон основной категории: единственный цветной знак в
 * тексте страницы, и он связывает факты с бейджем категории справа.
 */
const [mainCategory] = categories;
const factDot = mainCategory
	? TONE_CLASSES[categoryTone(mainCategory)].dot
	: "bg-border-strong";

/*
 * Правка ведется в файле той локали, которую человек читает: он видит
 * опечатку в английском тексте и должен попасть туда, где она есть.
 * Английского перевода может не быть - тогда правится русский исходник,
 * он источник истины.
 */
const translations = await getCollection("cardsEn");
const hasTranslation = translations.some((entry) => entry.id === card.id);
const editFolder = locale === "en" && hasTranslation ? "cards-en" : "cards";
const editHref = config.site.repository
	? `${config.site.repository}/edit/main/src/data/${editFolder}/${card.id}.md`
	: undefined;
---

<article class="flex flex-col" data-pagefind-body>
	<div
		class="relative grid aspect-[16/9] place-items-center overflow-hidden rounded-lg corner-squircle ring-1 ring-black/5 ring-inset sm:aspect-[21/9]"
		style={cover}
	>
		<div class="rounded-lg corner-squircle shadow-lift">
			<CardLogo name={name} logo={logo} peoples={peoples} size="xl" priority />
		</div>
	</div>

	<h1
		class="mt-8 font-semibold text-[clamp(2.25rem,4.6vw,3.75rem)] text-balance text-foreground leading-none tracking-[-0.05em]"
	>
		{name}
	</h1>
	<p class="mt-5 max-w-[56ch] text-lg text-muted-foreground leading-relaxed text-pretty">
		{description}
	</p>

	<div class="mt-7 flex flex-wrap items-center gap-2">
		<Button href={url} preset="solid" external>
			{host}
			<Icon name="tabler:arrow-up-right" class="size-4" aria-hidden="true" />
		</Button>
		<SaveButton cardId={card.id} locale={locale} size="md" withLabel />
	</div>

	<section class="mt-12">
		<h2 class="mb-3 font-medium font-mono text-[11px] text-faint uppercase tracking-wider">
			{t("card.facts")}
		</h2>
		<!-- Факты - независимые утверждения (см. CONTEXT.md), поэтому список
		     без нумерации: строки на линиях, точка вместо номера. -->
		<ul class="border-border border-t">
			{facts.map((fact) => (
				<li class="flex gap-3.5 border-border border-b py-3.5 text-[15px] text-foreground leading-relaxed">
					<span
						class={cn("mt-[0.6em] size-1.5 shrink-0 rounded-full", factDot)}
						aria-hidden="true"
					></span>
					{fact}
				</li>
			))}
		</ul>
	</section>

	<footer
		class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-faint text-xs"
	>
		<span>
			{t("card.added")} <time datetime={dateValue}>{dateLabel}</time>
		</span>
		{editHref && (
			<a
				href={editHref}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 underline-offset-4 transition-colors hover:text-foreground hover:underline"
			>
				<Icon name="tabler:pencil" class="size-3.5" aria-hidden="true" />
				{t("card.edit")}
			</a>
		)}
	</footer>
</article>
