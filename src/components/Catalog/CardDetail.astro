---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { config } from "main.config";
import CardLogo from "@/components/Catalog/CardLogo.astro";
import { peopleLabel } from "@/components/Catalog/labels";
import SaveButton from "@/components/Catalog/SaveButton.astro";
import {
	categoryIcon,
	categoryLabel,
	tagLabel,
} from "@/components/Catalog/taxonomy";
import Button from "@/components/partials/Button.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

interface Props {
	card: CollectionEntry<"cards">;
	locale: LocaleCode;
}

const { card, locale } = Astro.props;
const {
	name,
	description,
	facts,
	url,
	logo,
	categories,
	tags,
	peoples,
	pubDate,
} = card.data;
const t = useTranslations(locale);

/*
 * Домен показывается рядом с кнопкой: человек уходит на чужой сайт и имеет
 * право видеть куда, не наводя курсор на ссылку.
 */
const host = new URL(url).hostname.replace(/^www\./, "");

const dateLabel = new Intl.DateTimeFormat(locale, {
	day: "numeric",
	month: "long",
	year: "numeric",
}).format(pubDate);

/*
 * Правка ведется в файле той локали, которую человек читает: он видит
 * опечатку в английском тексте и должен попасть туда, где она есть.
 * Английского перевода может не быть - тогда правится русский исходник,
 * он источник истины.
 */
const translations = await getCollection("cardsEn");
const hasTranslation = translations.some((entry) => entry.id === card.id);
const editFolder = locale === "en" && hasTranslation ? "cards-en" : "cards";
const editHref = config.site.repository
	? `${config.site.repository}/edit/main/src/data/${editFolder}/${card.id}.md`
	: undefined;

/** Пилюли ведут в каталог: категория - на страницу раздела, тег - в фильтр. */
const categoryHref = (category: string) =>
	getRelativeLocaleUrl(locale, `catalog/${category}`);
const tagHref = (tag: string) =>
	`${getRelativeLocaleUrl(locale, "catalog")}?tags=${tag}`;
---

<article
	class="rounded-4xl corner-squircle bg-background p-6 shadow-xs sm:p-10"
	data-pagefind-body
>
	<div class="flex flex-col items-center gap-5 text-center">
		<div class="rounded-full corner-squircle bg-background shadow-sm">
			<CardLogo name={name} logo={logo} peoples={peoples} size="xl" priority />
		</div>

		<h1 class="font-bold text-3xl text-balance sm:text-4xl">{name}</h1>
	</div>

	<!--
	     Ниже шапки текст выравнивается влево: описание и факты читают, а у
	     центрированного текста нет левого края, за который цепляется глаз
	     при переходе на следующую строку.
	-->
	<div class="mx-auto mt-8 flex w-full max-w-2xl flex-col gap-6">
		<p class="text-lg text-muted-foreground">{description}</p>

		<div class="flex flex-wrap items-center gap-4">
			<div class="flex flex-col gap-1">
				<Button href={url} preset="solid" external>
					{t("card.visit")}
				</Button>
				<span class="pl-1 text-muted-foreground text-xs">{host}</span>
			</div>

			<SaveButton cardId={card.id} locale={locale} size="md" withLabel />
		</div>

		<div class="flex flex-wrap items-center gap-1.5">
			{categories.map((category) => (
				<a
					href={categoryHref(category)}
					class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 font-medium text-primary text-xs transition hover:bg-primary/20"
				>
					<Icon name={categoryIcon(category)} class="size-3.5" aria-hidden="true" />
					{categoryLabel(locale, category)}
				</a>
			))}
			{tags.map((tag) => (
				<a
					href={tagHref(tag)}
					class="inline-block rounded-full bg-muted px-2.5 py-1 text-muted-foreground text-xs transition hover:bg-muted/70 hover:text-foreground"
				>
					#{tagLabel(locale, tag)}
				</a>
			))}
		</div>

		<ul class="flex flex-wrap gap-3 divide-x divide-border/60">
			{peoples.map((people) => (
				<li class="pl-3 text-muted-foreground text-xs first:pl-0">
					{peopleLabel(locale, people)}
				</li>
			))}
		</ul>
	</div>

	<section class="mx-auto mt-10 w-full max-w-2xl">
		<h2 class="font-semibold text-lg">{t("card.facts")}</h2>

		<!--
		     Факты не нумеруются: это независимые утверждения о проекте, а не
		     шаги и не рейтинг - цифры навязали бы им несуществующий порядок.
		-->
		<ul class="mt-4 grid gap-3">
			{facts.map((fact) => (
				<li class="flex gap-3 text-sm">
					<span
						class="mt-2 size-1.5 shrink-0 rounded-full bg-border"
						aria-hidden="true"
					></span>
					{fact}
				</li>
			))}
		</ul>
	</section>

	<!--
	     Служебная подпись: дата и приглашение поправить. Гостю из поиска
	     неоткуда узнать, что за карточками стоят живые люди, а данные могут
	     устареть.
	-->
	<footer
		class="mx-auto mt-10 flex w-full max-w-2xl flex-wrap items-center gap-x-3 gap-y-1 border-border/60 border-t pt-5 text-muted-foreground text-xs"
	>
		<span>{t("card.added")} {dateLabel}</span>
		{editHref && (
			<a
				href={editHref}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1 underline underline-offset-4 transition hover:text-foreground"
			>
				<Icon name="mdi:pencil-outline" class="size-3.5" aria-hidden="true" />
				{t("card.edit")}
			</a>
		)}
	</footer>
</article>
