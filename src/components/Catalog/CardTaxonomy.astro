---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import PeopleBadge from "@/components/Catalog/PeopleBadge.astro";
import {
	type Category,
	categoryIcon,
	categoryLabel,
	type Tag,
	tagLabel,
} from "@/components/Catalog/taxonomy";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

/**
 * Разделы, теги и народы проекта отдельным блоком: на странице это не часть рассказа
 * о проекте, а выходы обратно в каталог. Поэтому у них свои заголовки и
 * место в колонке рядом, а не строка пилюль посреди описания.
 */

type People = CollectionEntry<"cards">["data"]["peoples"][number];

interface Props {
	locale: LocaleCode;
	categories: readonly Category[];
	tags: readonly Tag[];
	peoples: readonly People[];
	class?: string;
}

const {
	locale,
	categories,
	tags,
	peoples,
	class: className = "",
} = Astro.props;
const t = useTranslations(locale);

/** Категория ведет на страницу раздела, тег - в каталог с включенным фильтром. */
const categoryHref = (category: Category) =>
	getRelativeLocaleUrl(locale, `catalog/${category}`);
const tagHref = (tag: Tag) =>
	`${getRelativeLocaleUrl(locale, "catalog")}?tags=${tag}`;
---

<div class={`flex flex-col gap-6 ${className}`}>
	{categories.length > 0 && (
		<section>
			<h2 class="font-semibold text-muted-foreground text-xs uppercase tracking-wide">
				{t("catalog.category.label")}
			</h2>

			<ul class="mt-3 flex flex-wrap gap-1.5">
				{categories.map((category) => (
					<li>
						<a
							href={categoryHref(category)}
							class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 font-medium text-primary text-xs transition hover:bg-primary/20"
						>
							<Icon name={categoryIcon(category)} class="size-3.5" aria-hidden="true" />
							{categoryLabel(locale, category)}
						</a>
					</li>
				))}
			</ul>
		</section>
	)}

	{peoples.length > 0 && (
		<section>
			<h2 class="font-semibold text-muted-foreground text-xs uppercase tracking-wide">
				{t("card.peoples")}
			</h2>

			<ul class="mt-3 flex flex-wrap gap-1.5">
				{peoples.map((people) => (
					<li>
						<PeopleBadge locale={locale} people={people} />
					</li>
				))}
			</ul>
		</section>
	)}

	{tags.length > 0 && (
		<section>
			<h2 class="font-semibold text-muted-foreground text-xs uppercase tracking-wide">
				{t("catalog.filter.label")}
			</h2>

			<ul class="mt-3 flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<li>
						<a
							href={tagHref(tag)}
							class="inline-block rounded-full bg-muted px-2.5 py-1 text-muted-foreground text-xs transition hover:bg-muted/70 hover:text-foreground"
						>
							#{tagLabel(locale, tag)}
						</a>
					</li>
				))}
			</ul>
		</section>
	)}
</div>
