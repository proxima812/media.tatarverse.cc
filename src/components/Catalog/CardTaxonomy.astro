---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PeopleBadge from "@/components/Catalog/PeopleBadge.astro";
import TaxonomyChip from "@/components/Catalog/TaxonomyChip.astro";
import type { Category, Tag } from "@/lib/taxonomy";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

/**
 * Разделы, теги и народы проекта отдельным блоком: на странице это не часть рассказа
 * о проекте, а выходы обратно в каталог. Поэтому у них свои заголовки и
 * место в колонке рядом, а не строка пилюль посреди описания.
 */

type People = CollectionEntry<"cards">["data"]["peoples"][number];

interface Props {
	locale: LocaleCode;
	categories: readonly Category[];
	tags: readonly Tag[];
	peoples: readonly People[];
	class?: string;
}

const {
	locale,
	categories,
	tags,
	peoples,
	class: className = "",
} = Astro.props;
const t = useTranslations(locale);

/** Категория ведет на страницу раздела, тег - в каталог с включенным фильтром. */
const categoryHref = (category: Category) =>
	getRelativeLocaleUrl(locale, `catalog/${category}`);
const tagHref = (tag: Tag) =>
	`${getRelativeLocaleUrl(locale, "catalog")}?tags=${tag}`;
---

<!-- Метаданные проекта - определения на линиях, как таблица свойств:
     подпись слева, значения справа. Читается сверху вниз одним взглядом
     и не спорит с крупным заголовком слева. -->
<dl class={`border-border border-t text-sm ${className}`}>
	{categories.length > 0 && (
		<div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-3 border-border border-b py-3.5">
			<dt class="pt-0.5 text-muted-foreground">
				{t("catalog.category.label")}
			</dt>
			<dd>
			<ul class="flex flex-wrap gap-1.5">
				{categories.map((category) => (
					<li>
						<TaxonomyChip
							locale={locale}
							kind="category"
							value={category}
							href={categoryHref(category)}
						/>
					</li>
				))}
			</ul>
			</dd>
		</div>
	)}

	{peoples.length > 0 && (
		<div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-3 border-border border-b py-3.5">
			<dt class="pt-0.5 text-muted-foreground">
				{t("card.peoples")}
			</dt>
			<dd>
			<ul class="flex flex-wrap gap-1.5">
				{peoples.map((people) => (
					<li>
						<PeopleBadge locale={locale} people={people} />
					</li>
				))}
			</ul>
			</dd>
		</div>
	)}

	{tags.length > 0 && (
		<div class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-3 border-border border-b py-3.5">
			<dt class="pt-0.5 text-muted-foreground">
				{t("catalog.filter.label")}
			</dt>
			<dd>
			<ul class="flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<li>
						<TaxonomyChip
							locale={locale}
							kind="tag"
							value={tag}
							href={tagHref(tag)}
						/>
					</li>
				))}
			</ul>
			</dd>
		</div>
	)}
</dl>
