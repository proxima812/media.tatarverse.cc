---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import CardLogo from "@/components/Catalog/CardLogo.astro";
import PeopleBadge from "@/components/Catalog/PeopleBadge.astro";
import SaveButton from "@/components/Catalog/SaveButton.astro";
import {
	categoryIcon,
	categoryLabel,
	tagLabel,
} from "@/lib/taxonomy";
import Button from "@/components/partials/Button.astro";
import { useTranslations } from "@/i18n";
import { meshGradient } from "@/lib/ui/meshGradient";

interface Props {
	card: CollectionEntry<"cards">;
}

const { card } = Astro.props;
const { name, facts, logo, url, categories, tags, peoples } = card.data;

const locale = Astro.currentLocale ?? "ru";
const t = useTranslations(locale);
const href = getRelativeLocaleUrl(locale, `projects/${card.id}`);

/** Домен вместо полного URL: на карточке важен источник, а не путь. */
const domain = new URL(url).hostname.replace(/^www\./, "");

/*
 * Раскладка по макету: за край корпуса выступает только шапка (лого + пилюля
 * с названием). Вынос сделан отрицательным отступом в потоке, а не absolute, -
 * высота карточки остается равной содержимому.
 *
 * Глубина набирается только слоями `ring` (не `border` - он не съедает
 * раскладку соседним контентом) и не тенями: подложка (мэш-градиент лого,
 * размытый) → корпус → плашка контента. Чем слой глубже, тем слабее его
 * контур - порядок читается по силе линии, а не по размытому пятну под
 * карточкой.
 */
const glow = meshGradient(name);
---

<article class="group relative flex w-full flex-col">
	<div
		class="-z-10 absolute inset-4 rounded-3xl opacity-30 blur-2xl"
		style={glow}
		aria-hidden="true"
	></div>

	<div class="relative z-20 flex h-16 items-center gap-3 px-5">
		<div
			class="shrink-0 rounded-full corner-squircle bg-background ring-1 ring-border"
		>
			<CardLogo size="lg" name={name} logo={logo} peoples={peoples} />
		</div>

		<h2
			class="flex min-w-0 text-sm flex-1 items-center rounded-2xl bg-background px-4 py-2 font-medium text-foreground ring-1 ring-border"
		>
			<span class="truncate">{name}</span>
		</h2>

		<SaveButton cardId={card.id} locale={locale} />
	</div>

	<div class="-mt-8 relative flex flex-1 flex-col">
		<div
			class="flex flex-1 flex-col gap-1.5 rounded-3xl bg-background p-2.5 pt-9 ring-1 ring-border/70"
		>
			<div
				class="flex flex-1 flex-col gap-4 rounded-2xl bg-background px-5 pt-9 pb-6 ring-1 ring-border/40"
			>
				<div class="flex flex-wrap items-center gap-1.5">
					{categories.map((category) => (
							<span class="inline-flex items-center gap-1 rounded-lg bg-primary/10 px-2 py-0.5 font-medium text-primary text-xs">
								<Icon name={categoryIcon(category)} class="size-3.5" aria-hidden="true" />
								{categoryLabel(locale, category)}
							</span>
						))}

					{tags.map((tag) => (
							<span class="rounded-lg bg-muted px-2 py-0.5 text-muted-foreground text-xs">
								#{tagLabel(locale, tag)}
							</span>
						))}

					{peoples.map((people) => (
							<PeopleBadge
								locale={locale}
								people={people}
								size="sm"
								class="rounded-lg"
							/>
						))}
				</div>

				<ul class="space-y-2 text-muted-foreground text-sm">
					{facts.map((fact) => (
							<li class="flex gap-2.5">
								<span
									class="mt-2 h-1 w-1 shrink-0 rounded-full bg-border"
									aria-hidden="true"
								/>
								{fact}
							</li>
						))}
				</ul>
			</div>

			<!--
				Подвал - слой корпуса, а не плашки контента: действия карточки
				(уйти на страницу проекта, уйти на сам проект) стоят рядом и
				отделены от текста тем же отступом `p-2.5`, что держит плашку.

				Раньше «Подробнее» выступала за нижний край корпуса, а домен
				лежал внутри контента отдельной строкой - два действия в двух
				разных слоях, между ними край карточки.
			-->
			<div class="flex items-center justify-between gap-3 px-2.5 pt-1 pb-1.5">
				<Button href={href} preset="solid" size="sm" radius="lg">
					{t("card.more")}
				</Button>

				<a
					href={url}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex min-w-0 items-center gap-1.5 text-muted-foreground text-xs underline-offset-4 transition hover:text-foreground hover:underline"
				>
					<span class="truncate">{domain}</span>
					<Icon
						name="mdi:open-in-new"
						class="size-3.5 shrink-0"
						aria-hidden="true"
					/>
				</a>
			</div>
		</div>
	</div>
</article>
