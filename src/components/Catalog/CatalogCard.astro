---
import type { CollectionEntry } from "astro:content";
import ProjectCover from "@/components/Catalog/ProjectCover.astro";
import type { LocaleCode } from "@/config/types";

/**
 * Карточка каталога - та же обложка, что в рядах главной, плюс закладка.
 * Одна карточка на весь сайт: раньше у каталога был свой многослойный
 * корпус с фактами и тегами, и проект в сетке выглядел иначе, чем на
 * главной. Факты и теги живут на странице проекта, куда ведет карточка.
 */
interface Props {
	card: CollectionEntry<"cards">;
}

const { card } = Astro.props;
const locale = (Astro.currentLocale ?? "ru") as LocaleCode;
---

<ProjectCover card={card} locale={locale} save />
