---
import type { CollectionEntry } from "astro:content";
import CatalogCard from "@/components/Catalog/CatalogCard.astro";

interface Props {
	cards: CollectionEntry<"cards">[];
	/** Сколько карточек попадает в DOM сразу. Остальные - порциями по скроллу. */
	initial?: number;
	/** Размер порции, которая подгружается при подходе к концу списка. */
	chunk?: number;
}

const { cards, initial = 12, chunk = 12 } = Astro.props;

/* Первую порцию рендерим сразу, остальные храним в template.
 * CatalogList сохраняет ссылки на все проекты в DOM. */
const head = cards.slice(0, initial);
const rest = cards.slice(initial);

const chunks: CollectionEntry<"cards">[][] = [];
for (let i = 0; i < rest.length; i += chunk) {
	chunks.push(rest.slice(i, i + chunk));
}
---

<div data-catalog-lazy class="group-data-[view=list]/catalog:hidden">

	<div
		data-catalog-items
		class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
	>
		{head.map((card) => (
				<div
					data-catalog-item
					data-tags={card.data.tags.join(",")}
					class="flex [&[hidden]]:hidden"
				>
					<CatalogCard card={card} />
				</div>
			))}
	</div>

	{chunks.map((group) => (
			<template data-catalog-chunk>
				{group.map((card) => (
						<div
							data-catalog-item
							data-tags={card.data.tags.join(",")}
							class="flex [&[hidden]]:hidden"
						>
							<CatalogCard card={card} />
						</div>
					))}
			</template>
		))}

	{chunks.length > 0 && (
			<div data-catalog-sentinel aria-hidden="true" class="h-px w-full"></div>
		)}
</div>

<script>
/* Загружаем порцию до появления конца списка на экране. */
const PRELOAD_MARGIN = "1200px";

function setupCatalogGrid(root: HTMLElement) {
	const container = root.querySelector<HTMLElement>("[data-catalog-items]");
	const sentinel = root.querySelector<HTMLElement>("[data-catalog-sentinel]");
	if (!container || !sentinel) return;

	const chunks = [
		...root.querySelectorAll<HTMLTemplateElement>("[data-catalog-chunk]"),
	];
	let next = 0;
	let observer: IntersectionObserver | undefined;

	const revealNext = () => {
		const template = chunks[next];
		if (!template) return false;
		next += 1;

		container.append(template.content);
		template.remove();
		return true;
	};

	const revealAll = () => {
		observer?.disconnect();
		while (revealNext()) {
			// Фильтру нужны все карточки, включая отложенные в template.
		}
		sentinel.remove();
	};

	root
		.closest("[data-catalog]")
		?.addEventListener("catalog:before-filter", revealAll);

	if (!("IntersectionObserver" in window)) {
		revealAll();
		return;
	}

	const intersectionObserver = new IntersectionObserver(
		(entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;

			if (!revealNext()) {
				intersectionObserver.disconnect();
				sentinel.remove();
				return;
			}

			/* Повторное observe проверяет сентинел, даже если он остался внутри rootMargin. */
			intersectionObserver.unobserve(sentinel);
			intersectionObserver.observe(sentinel);
		},
		{ rootMargin: PRELOAD_MARGIN },
	);
	observer = intersectionObserver;

	intersectionObserver.observe(sentinel);
}

for (const root of document.querySelectorAll<HTMLElement>(
	"[data-catalog-lazy]",
)) {
	setupCatalogGrid(root);
}
</script>
