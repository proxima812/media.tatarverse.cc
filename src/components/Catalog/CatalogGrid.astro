---
import type { CollectionEntry } from "astro:content";
import CatalogCard from "@/components/Catalog/CatalogCard.astro";

interface Props {
	cards: CollectionEntry<"cards">[];
	/** Сколько карточек попадает в DOM сразу. Остальные - порциями по скроллу. */
	initial?: number;
	/** Размер порции, которая подгружается при подходе к концу списка. */
	chunk?: number;
}

const { cards, initial = 12, chunk = 12 } = Astro.props;

/*
 * Каталог - это две сотни карточек, и каждая из них это ~25 узлов DOM плюс
 * логотип. Рендерить их все сразу дорого: браузер парсит разметку и красит
 * то, что никто не увидит.
 *
 * Поэтому в поток попадает только первая порция, а хвост уезжает в
 * `<template>` - разметка приходит тем же HTML (ее не надо доставать
 * запросом), но браузер ее не парсит в дерево, не размечает и не красит,
 * пока скрипт не вставит нужный кусок. Порции добавляются по одной, когда
 * сентинел под сеткой подходит к экрану.
 *
 * Ссылки на все проекты при этом остаются в настоящем DOM - их держит
 * списочный вид (`CatalogList`), он рендерится целиком и лишь скрыт
 * `display:none`. Так обход краулером и клавиатурная навигация не зависят
 * от JS, а стоимость первой отрисовки падает пропорционально числу порций.
 */
const head = cards.slice(0, initial);
const rest = cards.slice(initial);

const chunks: CollectionEntry<"cards">[][] = [];
for (let i = 0; i < rest.length; i += chunk) {
	chunks.push(rest.slice(i, i + chunk));
}

/**
 * Пороги для `MasonryGrid` - под брейкпоинты Tailwind (`sm` = 640px,
 * `lg` = 1024px): 1 колонка уже, 2 - начиная с `sm`, 3 - начиная с `lg`.
 */
const MASONRY_BREAKPOINTS = { default: 3, 1023: 2, 639: 1 };
---

<div data-catalog-lazy class="group-data-[view=list]/catalog:hidden">
	<!--
		До инициализации `MasonryGrid` карточки лежат плоским списком, и с
		`flex` без переноса они выстраивались в одну строку, уезжающую за
		правый край экрана. На быстрой машине это мелькало кадр, на
		медленной сети - секунды.

		Поэтому исходное состояние - обычные CSS-колонки (`columns-*`):
		браузер раскладывает их сам, еще до всякого JS, и выглядит это почти
		как итоговая раскладка. Скрипт ставит контейнеру `data-ready`,
		переключая его на flex-колонки - их строит уже сам `MasonryGrid`
		(зачем ему свои колонки вместо `columns`, объяснено в `masonry.ts`).

		Прятать карточки до готовности нельзя: без JS каталог остался бы
		пустой страницей.
	-->
	<div
		data-catalog-items
		data-masonry-breakpoints={JSON.stringify(MASONRY_BREAKPOINTS)}
		class="group/masonry gap-8 px-5 not-data-ready:columns-1 data-ready:flex data-ready:items-start sm:not-data-ready:columns-2 lg:not-data-ready:columns-3"
	>
		{head.map((card) => (
				<div
					data-catalog-item
					data-tags={card.data.tags.join(",")}
					class="break-inside-avoid not-group-data-ready/masonry:mb-8 [&[hidden]]:hidden"
				>
					<CatalogCard card={card} />
				</div>
			))}
	</div>

	{chunks.map((group) => (
			<template data-catalog-chunk>
				{group.map((card) => (
						<div data-catalog-item data-tags={card.data.tags.join(",")} class="[&[hidden]]:hidden">
							<CatalogCard card={card} />
						</div>
					))}
			</template>
		))}

	{chunks.length > 0 && (
			<div data-catalog-sentinel aria-hidden="true" class="h-px w-full"></div>
		)}
</div>

<script>
import { type MasonryBreakpoints, MasonryGrid } from "@/utils/lib/masonry";

/*
 * Порог `rootMargin` намеренно большой: порция должна успеть появиться до
 * того, как пользователь доскроллит до конца, иначе видно пустоту.
 */
const PRELOAD_MARGIN = "1200px";

function setupCatalogGrid(root: HTMLElement) {
	const container = root.querySelector<HTMLElement>("[data-catalog-items]");
	const sentinel = root.querySelector<HTMLElement>("[data-catalog-sentinel]");
	if (!container) return;

	/*
	 * Карточки приходят в DOM плоским списком (порядок из `cards`) - колонки
	 * появляются только в браузере, их создает `MasonryGrid`. Ссылки на
	 * исходные узлы снимаются до конструктора: он сразу очищает контейнер
	 * под свои колонки, а без сохраненных ссылок начальную порцию было бы
	 * нечем в них раскладывать.
	 */
	const initialItems = Array.from(container.children) as HTMLElement[];

	// Разметка из `MASONRY_BREAKPOINTS` приходит тем же HTML в data-атрибуте -
	// без отдельного запроса и без риска рассинхронизации с версткой.
	const breakpoints = JSON.parse(
		container.dataset.masonryBreakpoints ?? "{}",
	) as MasonryBreakpoints;

	const masonry = new MasonryGrid(container, breakpoints);
	for (const item of initialItems) masonry.addItem(item);

	if (!sentinel) return;

	const chunks = [
		...root.querySelectorAll<HTMLTemplateElement>("[data-catalog-chunk]"),
	];
	let next = 0;
	let observer: IntersectionObserver | undefined;

	const revealNext = () => {
		const template = chunks[next];
		if (!template) return false;
		next += 1;

		const items = Array.from(template.content.children) as HTMLElement[];
		template.remove();
		for (const item of items) masonry.addItem(item);
		return true;
	};

	const revealAll = () => {
		observer?.disconnect();
		while (revealNext()) {
			// Фильтру нужны все карточки, включая отложенные в template.
		}
		sentinel.remove();
	};

	root
		.closest("[data-catalog]")
		?.addEventListener("catalog:before-filter", revealAll);

	if (!("IntersectionObserver" in window)) {
		revealAll();
		return;
	}

	const intersectionObserver = new IntersectionObserver(
		(entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;

			if (!revealNext()) {
				intersectionObserver.disconnect();
				sentinel.remove();
				return;
			}

			/*
			 * Одна порция за срабатывание - но сентинел после вставки может
			 * остаться внутри `rootMargin`, а непрерывное пересечение второго
			 * колбэка не дает. Перевешиваем наблюдатель: это принудительно
			 * запускает новую проверку, и порции доезжают до тех пор, пока
			 * сентинел не уйдет за порог.
			 */
			intersectionObserver.unobserve(sentinel);
			intersectionObserver.observe(sentinel);
		},
		{ rootMargin: PRELOAD_MARGIN },
	);
	observer = intersectionObserver;

	intersectionObserver.observe(sentinel);
}

for (const root of document.querySelectorAll<HTMLElement>(
	"[data-catalog-lazy]",
)) {
	setupCatalogGrid(root);
}
</script>
