---
import type { CollectionEntry } from "astro:content";
import CatalogRow from "@/components/Catalog/CatalogRow.astro";

interface Props {
	cards: CollectionEntry<"cards">[];
}

const { cards } = Astro.props;
---

<div
	class="w-full overflow-hidden rounded-md border-border border-t group-data-[view=grid]/catalog:hidden"
>
	{cards.map((card) => <CatalogRow card={card} />)}
</div>
