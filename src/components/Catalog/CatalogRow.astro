---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
	categoryLabel,
	peopleLabel,
	tagLabel,
} from "@/components/Catalog/labels";

interface Props {
	card: CollectionEntry<"cards">;
}

const { card } = Astro.props;
const { name, categories, tags, peoples } = card.data;

const locale = Astro.currentLocale ?? "ru";
const href = getRelativeLocaleUrl(locale, `projects/${card.id}`);
---

<a
	href={href}
	data-catalog-item
	data-catalog-list-item
	data-tags={tags.join(",")}
	class="flex content-auto [contain-intrinsic-size:auto_4rem] items-center justify-between gap-4 border-border border-b px-4 py-5 transition hover:bg-muted/60 [&[hidden]]:hidden"
>
	<span class="min-w-0 truncate font-medium text-base text-foreground">
		{name}
	</span>

	<span
		class="flex shrink-0 items-center gap-3 text-muted-foreground text-xs uppercase tracking-wide"
	>
		<span
			>{categories.map((category) => categoryLabel(locale, category)).join(", ")}</span
		>
		<span class="hidden md:inline"
			>{tags.map((tag) => tagLabel(locale, tag)).join(", ")}</span
		>
		<span class="hidden sm:inline"
			>{peoples.map((people) => peopleLabel(locale, people)).join(", ")}</span
		>
	</span>
</a>
