---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { peopleLabel, tagLabel } from "@/components/Catalog/labels";

interface Props {
	card: CollectionEntry<"cards">;
}

const { card } = Astro.props;
const { name, tags, peoples } = card.data;

const locale = Astro.currentLocale ?? "ru";
const href = getRelativeLocaleUrl(locale, `projects/${card.id}`);
---

<a
	href={href}
	class="flex content-auto [contain-intrinsic-size:auto_4rem] items-center justify-between gap-4 border-border border-b px-4 py-5 transition hover:bg-muted/60"
>
	<span class="min-w-0 truncate font-medium text-base text-foreground">
		{name}
	</span>

	<span
		class="flex shrink-0 items-center gap-3 text-muted-foreground text-xs uppercase tracking-wide"
	>
		<span>{tags.map((tag) => tagLabel(locale, tag)).join(", ")}</span>
		<span class="hidden sm:inline"
			>{peoples.map((people) => peopleLabel(locale, people)).join(", ")}</span
		>
	</span>
</a>
