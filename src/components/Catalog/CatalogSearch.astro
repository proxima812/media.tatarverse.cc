---
import { cn } from "cn";
import StrokeIcon from "@/components/partials/StrokeIcon.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

interface Props {
	locale: LocaleCode;
	class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);

/*
 * Поле поиска по каталогу. Это не полнотекстовый поиск по сайту, а фильтр
 * алфавитного списка: весь каталог уже лежит в DOM страницы, и фильтрация
 * идет на месте - записи, которые не подошли, просто скрываются
 * (см. скрипт в `CatalogGlossary.astro`).
 *
 * Раньше здесь стоял Pagefind. Он отвечает на другой вопрос - «найди
 * страницу по индексу и покажи выдачу», - и его выпадающий список
 * подменял бы собой сам список каталога вместо того, чтобы его сужать.
 *
 * Размеры пилюли (727×68, радиус 20) повторяют оригинал, по которому ее
 * просили сделать. Знак поиска - не иконка из набора, а собственный
 * штриховой глиф: он должен совпадать по весу с крестиком очистки, а
 * `mdi:magnify` заливной и рядом с ним читался как чужой набор.
 */
---

<search class={cn("w-full", className)}>
	<div class="group relative mx-auto w-full max-w-[727px]">
		<label class="sr-only" for="catalog-search">
			{t("catalog.search.placeholder")}
		</label>

		<!-- `z-10` обязателен: у поля стоит `backdrop-filter`, а он заводит
		     собственный контекст наложения и красит поле как `z-index: 0`.
		     Плашка со знаком и линейка лежат в разметке раньше поля, поэтому
		     без явного z-index они оказывались под его фоном. -->
		<span
			class="pointer-events-none absolute top-1/2 left-2.5 z-10 flex size-9 -translate-y-1/2 items-center justify-center rounded-sm bg-background/13 text-background transition group-focus-within:bg-background group-focus-within:text-foreground sm:left-3.5 sm:size-11 sm:rounded-md"
			aria-hidden="true"
		>
			<!-- Лупа штриховая, вес 2 - тот же, что у крестика очистки справа:
			     заливной глиф рядом со штриховым читался как два разных набора. -->
			<StrokeIcon name="magnify" class="size-4.5 sm:size-5" />
		</span>

		<!-- Волосяная линейка отделяет зону знака от зоны текста. -->
		<span
			class="pointer-events-none absolute top-1/2 left-13.5 z-10 h-6 w-px -translate-y-1/2 bg-background/16 sm:left-17 sm:h-7"
			aria-hidden="true"
		></span>

		<!--
			Заливка 70%, а не 88%: при 88% сквозь поле проходит 12% фона и
			размывать backdrop-filter было нечего - эффект был объявлен, но не
			виден. Вместе с заливкой поднят и радиус размытия.

			Внутренний блик сверху дает стеклу край: без него полупрозрачная
			плита выглядит как просто темный прямоугольник.
		-->
		<input
			id="catalog-search"
			data-glossary-search
			type="search"
			autocomplete="off"
			spellcheck="false"
			placeholder={t("catalog.search.placeholder")}
			class="h-14 w-full rounded-lg corner-squircle bg-foreground/70 pr-12 pl-17 text-background text-base leading-normal shadow-[inset_0_1px_0_color-mix(in_oklab,var(--color-background)_16%,transparent)] outline-none backdrop-blur-[24px] backdrop-saturate-150 transition placeholder:text-background/58 focus:outline-none focus-visible:outline-none sm:h-17 sm:pr-14 sm:pl-21 sm:text-xl [&::-webkit-search-cancel-button]:appearance-none"
		>

		<!-- Кнопка очистки поверх поля: нативный крестик `type="search"`
		     выключен выше - он есть только в WebKit и красится системно,
		     а не под темную пилюлю. -->
		<button
			type="button"
			data-glossary-search-clear
			hidden
			aria-label={t("search.clear")}
			class="-translate-y-1/2 absolute top-1/2 right-4 z-10 flex size-8 cursor-pointer items-center justify-center rounded-full text-background/65 transition hover:bg-background/10 hover:text-background sm:right-6"
		>
			<StrokeIcon name="close" size={16} />
		</button>
	</div>
</search>

<script>
/*
 * Cmd+K (Ctrl+K вне macOS) ставит курсор в поле поиска, не сдвигая
 * страницу к нему. Escape возвращает фокус обратно на страницу.
 *
 * Клавиша ловится по `event.code`, а не по `event.key`: в русской
 * раскладке Cmd+K дает `key === "л"`, и проверка по букве не сработала
 * бы ровно на той аудитории, ради которой сайт и сделан.
 *
 * `preventDefault` обязателен: в Firefox Cmd+K уводит фокус в строку
 * поиска браузера, а в Chrome по Ctrl+K открывается омнибокс.
 */
const field = document.querySelector<HTMLInputElement>(
	"[data-glossary-search]",
);

if (field) {
	document.addEventListener("keydown", (event) => {
		if (event.code === "KeyK" && (event.metaKey || event.ctrlKey)) {
			event.preventDefault();
			/* `preventScroll`: страницу к полю не тянем - его могли вызвать из середины каталога. */
			field.focus({ preventScroll: true });
			/* Набранное выделяется целиком: следующий символ начинает новый запрос, а не дописывает старый. */
			field.select();
			return;
		}

		if (event.key === "Escape" && document.activeElement === field) {
			field.blur();
		}
	});
}
</script>
