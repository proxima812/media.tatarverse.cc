---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { tagLabel } from "@/components/Catalog/labels";
import { tagIcon } from "@/components/Catalog/tagIcons";
import type { Tag } from "@/components/Catalog/tags";
import Button from "@/components/partials/Button.astro";
import Tooltip from "@/components/partials/Tooltip.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

interface Props {
	locale: LocaleCode;
	/** Теги, у которых есть карточки. Пустых вкладок в тулбаре не бывает. */
	tags: Tag[];
	/** Тег текущей страницы. `undefined` - раздел «Все проекты». */
	activeTag?: Tag | undefined;
}

const { locale, tags, activeTag } = Astro.props;
const t = useTranslations(locale);

/** «Все проекты» + по одной записи на тег - общий список для строки вкладок и диалога. */
const entries = [
	{
		href: getRelativeLocaleUrl(locale, "catalog"),
		label: t("catalog.filter.all"),
		icon: "mdi:view-grid-outline",
		active: activeTag === undefined,
	},
	...tags.map((tag) => ({
		href: getRelativeLocaleUrl(locale, `catalog/${tag}`),
		label: tagLabel(locale, tag),
		icon: tagIcon(tag),
		active: tag === activeTag,
	})),
];

/*
 * Вкладки - настоящие ссылки на `/catalog` и `/catalog/<tag>`, а не кнопки с
 * JS-фильтром: у каждого тега своя страница (см. `starter-i18n`), поэтому
 * переключение - обычная навигация, и активное состояние - `aria-current`,
 * а не запоминаемый клиентом `aria-pressed`.
 *
 * `aria-current` - не готовый вариант Tailwind (в отличие от `aria-pressed`
 * и `aria-selected`), поэтому селектор с явным значением: `aria-[current=page]`.
 * Просто `aria-current:` молча ничего не генерирует, и активная вкладка
 * визуально не отличалась от остальных.
 *
 * `inline-block` обязателен: `<a>` по умолчанию `inline`, а у инлайновых
 * элементов вертикальный `padding` красится визуально, но не входит в высоту
 * строки. Раньше вкладки были кнопками (у `<button>` UA-стиль - уже
 * `inline-block`), и это работало само собой; после замены на `<a>` пилюля
 * рисовалась на несколько px выше своего же layout-бокса.
 */
const tabClass =
	"inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-muted px-4 py-2 font-medium text-muted-foreground text-sm transition hover:bg-muted/70 hover:text-foreground aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground";

/** Пункт того же списка тегов, но в диалоге - строкой на всю ширину. */
const dialogLinkClass =
	"flex items-center gap-2 rounded-xl px-3 py-2 font-medium text-muted-foreground text-sm transition hover:bg-muted hover:text-foreground aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground";

const viewClass =
	"group relative rounded-xl p-2 text-muted-foreground transition hover:text-foreground aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-sm";
---

<div class="flex flex-wrap items-center justify-between gap-3 px-5 pb-8">
	<nav aria-label={t("catalog.filter.label")} class="min-w-0 flex-1">
		<ul data-tag-list class="flex items-center gap-2 overflow-hidden">
			{entries.map((entry) => (
					<li data-tag-item>
						<a href={entry.href} class={tabClass} aria-current={entry.active ? "page" : undefined}>
							<Icon name={entry.icon} class="size-4 shrink-0" aria-hidden="true" />
							{entry.label}
						</a>
					</li>
				))}

			<!--
				Всегда в конце строки на мобильном: на узком экране пилюли почти
				никогда не влезают все разом, а мигающая по ширине контента кнопка
				(то есть, то нет) хуже стабильно видимой. `[data-tag-list]` прячет
				лишние `[data-tag-item]` скриптом ниже - эта кнопка их место не
				занимает, стоит своим последним `<li>`.
			-->
			<li class="sm:hidden">
				<Button
					preset="soft"
					data-tags-open
					aria-haspopup="dialog"
					aria-controls="catalog-tags-dialog"
					class="gap-1"
				>
					{t("catalog.filter.allTags")}
					<svg
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M6 9l6 6 6-6" />
					</svg>
				</Button>
			</li>
		</ul>
	</nav>

	<fieldset class="flex items-center gap-1 rounded-2xl bg-muted p-1.5">
		<legend class="sr-only">{t("catalog.view.label")}</legend>

		<button
			type="button"
			class={viewClass}
			data-view-button="list"
			aria-pressed="false"
		>
			<span class="sr-only">{t("catalog.view.list")}</span>
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M4 6h.01M4 12h.01M4 18h.01M9 6h11M9 12h11M9 18h11" />
			</svg>
			<Tooltip label={t("catalog.view.list")} />
		</button>

		<button
			type="button"
			class={viewClass}
			data-view-button="grid"
			aria-pressed="true"
		>
			<span class="sr-only">{t("catalog.view.grid")}</span>
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<rect x="3" y="3" width="7" height="7" rx="1.5" />
				<rect x="14" y="3" width="7" height="7" rx="1.5" />
				<rect x="3" y="14" width="7" height="7" rx="1.5" />
				<rect x="14" y="14" width="7" height="7" rx="1.5" />
			</svg>
			<Tooltip label={t("catalog.view.grid")} />
		</button>
	</fieldset>
</div>

<dialog
	id="catalog-tags-dialog"
	data-tags-dialog
	class="m-auto max-h-[70vh] w-[calc(100%-2rem)] max-w-sm overflow-y-auto rounded-3xl border border-border bg-background p-4 shadow-black/10 shadow-lg backdrop:bg-background/70 backdrop:backdrop-blur-sm"
>
	<div class="flex items-center justify-between gap-4 pb-3">
		<p class="font-semibold text-foreground">{t("catalog.filter.label")}</p>
		<Button
			preset="ghost"
			size="icon"
			data-tags-close
			aria-label={t("catalog.filter.close")}
			class="group relative"
		>
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M6 6l12 12M18 6L6 18" />
			</svg>
			<Tooltip label={t("catalog.filter.close")} />
		</Button>
	</div>

	<ul class="flex flex-col gap-1">
		{entries.map((entry) => (
				<li>
					<a href={entry.href} class={dialogLinkClass} aria-current={entry.active ? "page" : undefined}>
						<Icon name={entry.icon} class="size-4 shrink-0" aria-hidden="true" />
						{entry.label}
					</a>
				</li>
			))}
	</ul>
</dialog>

<script>
/**
 * Хвост тегов, которые не влезли в строку на мобильном, прячется - не
 * горизонтальным скроллом (был обрезанный по высоте край и лишний скролл
 * из-за него), а через `hidden`. Гарантированно видна только кнопка «Все
 * теги»: на самых узких экранах даже «Все проекты» рядом с ней не влезает,
 * а внутри диалога «Все теги» есть и «Все проекты» - пункт не теряется,
 * просто уходит на один клик дальше.
 */
function setupTagOverflow(list: HTMLElement) {
	const items = list.querySelectorAll<HTMLElement>("[data-tag-item]");
	const moreItem = list
		.querySelector<HTMLElement>("[data-tags-open]")
		?.closest("li");
	if (!moreItem || items.length === 0) return;

	const GAP_PX = 8;

	const recalc = () => {
		for (const item of items) item.classList.remove("hidden");

		// `sm:hidden` на кнопке - обрезка только на мобильном, на широком экране
		// вкладки и так помещаются в ряд (см. CatalogToolbar.astro).
		if (getComputedStyle(moreItem).display === "none") return;

		const available = list.clientWidth;
		let used = moreItem.offsetWidth + GAP_PX;

		for (const item of items) {
			used += item.offsetWidth + GAP_PX;
			if (used > available) item.classList.add("hidden");
		}
	};

	recalc();
	window.addEventListener("resize", recalc);
}

/** `aria-controls` указывает на id диалога - та же связка, что у мобильного меню в `Header.astro`. */
function setupTagsDialog(openButton: HTMLButtonElement) {
	const dialog = document.getElementById(
		openButton.getAttribute("aria-controls") ?? "",
	);
	if (!(dialog instanceof HTMLDialogElement)) return;

	// `showModal()` сам по себе фон не блокирует - особенно на мобильном
	// Safari страница под диалогом все еще скроллится свайпом. `close` - один
	// обработчик снятия блокировки на все способы закрытия (крестик, клик по
	// `::backdrop`, Esc), а не дублировать его в каждом из них.
	openButton.addEventListener("click", () => {
		dialog.showModal();
		document.documentElement.classList.add("overflow-hidden");
	});
	dialog.addEventListener("close", () => {
		document.documentElement.classList.remove("overflow-hidden");
	});

	dialog
		.querySelector<HTMLButtonElement>("[data-tags-close]")
		?.addEventListener("click", () => dialog.close());

	// Клик по `::backdrop` и по паддингу самого `<dialog>` - цель события сам
	// `<dialog>`; клик по ссылке внутри - цель ссылка, диалог не закроется.
	dialog.addEventListener("click", (event) => {
		if (event.target === dialog) dialog.close();
	});
}

for (const list of document.querySelectorAll<HTMLElement>("[data-tag-list]")) {
	setupTagOverflow(list);
}
for (const openButton of document.querySelectorAll<HTMLButtonElement>(
	"[data-tags-open]",
)) {
	setupTagsDialog(openButton);
}
</script>
