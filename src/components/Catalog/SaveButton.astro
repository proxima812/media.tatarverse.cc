---
import { Icon } from "astro-icon/components";
import Tooltip from "@/components/ui/Tooltip.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

interface Props {
	cardId: string;
	locale: LocaleCode;
	size?: "sm" | "md";
	/**
	 * Показать подпись рядом с иконкой. Нужна там, где кнопка стоит одна и
	 * человек видит ее впервые - на странице проекта; в сетке каталога для
	 * подписи нет места, и там работает подсказка с `aria-label`.
	 */
	withLabel?: boolean;
}

const { cardId, locale, size = "sm", withLabel = false } = Astro.props;
const t = useTranslations(locale);

/** Иконка в кружке, если подписи нет, и пилюля с текстом, если есть. */
const sizes = {
	sm: withLabel ? "h-9 gap-2 px-3.5" : "size-9",
	md: withLabel ? "h-10 gap-2 px-4" : "size-10",
} as const;

const icon = size === "md" ? "size-5" : "size-4.5";
---

<button
	type="button"
	data-save-button
	data-card-id={cardId}
	aria-pressed="false"
	aria-label={t("saved.add")}
	class={`group relative inline-flex cursor-pointer shrink-0 items-center justify-center rounded-full bg-background text-muted-foreground text-sm ring-1 ring-border transition hover:text-foreground ${sizes[size]}`}
>
	<Icon
		name="mdi:heart-outline"
		class={`${icon} group-aria-pressed:hidden`}
		aria-hidden="true"
	/>
	<Icon
		name="mdi:cards-heart"
		class={`hidden text-red-500 group-aria-pressed:block ${icon}`}
		aria-hidden="true"
	/>

	{withLabel && (
			<>
				<span class="group-aria-pressed:hidden">{t("saved.add")}</span>
				<span class="hidden group-aria-pressed:inline">{t("card.saved")}</span>
			</>
		)}

	<!-- Две подписи вместо одной: текст зависит от состояния кнопки, а состояние
	     переключает клиентский скрипт через `aria-pressed` - так подпись меняется
	     без участия JS. -->
	{!withLabel && (
			<>
				<Tooltip label={t("saved.add")} class="group-aria-pressed:hidden" />
				<Tooltip label={t("saved.remove")} class="hidden group-aria-pressed:block" />
			</>
		)}
</button>

<script>
/*
 * Хранилище и событие `catalog:saved-change` живут в `savedStore.ts` -
 * общий модуль для кнопки, страницы `/saved` и счетчика в шапке. Кнопка
 * сама переключает свое состояние и все свои копии на странице (одна и
 * та же карточка может стоять и в каталоге, и на странице проекта
 * одновременно - оба места должны быть в courant).
 */
import { readSaved, toggleSaved } from "@/lib/catalog/savedStore";

function applyState(button: HTMLButtonElement, saved: string[]) {
	button.setAttribute(
		"aria-pressed",
		String(saved.includes(button.dataset.cardId ?? "")),
	);
}

function toggle(button: HTMLButtonElement) {
	const id = button.dataset.cardId;
	if (!id) return;

	const { saved } = toggleSaved(id);

	for (const match of document.querySelectorAll<HTMLButtonElement>(
		`[data-save-button][data-card-id="${CSS.escape(id)}"]`,
	)) {
		applyState(match, saved);
	}
}

/** Проставляет актуальное состояние всем кнопкам внутри узла (и ему самому). */
function syncButtons(nodes: Iterable<Element>) {
	const saved = readSaved();

	for (const node of nodes) {
		if (node.matches("[data-save-button]")) {
			applyState(node as HTMLButtonElement, saved);
		}

		for (const button of node.querySelectorAll<HTMLButtonElement>(
			"[data-save-button]",
		)) {
			applyState(button, saved);
		}
	}
}

/*
 * Клик ловится делегированием на документе, а не подпиской на каждую
 * кнопку. Каталог отдает в DOM только первую порцию карточек, остальные
 * лежат в `<template>` и вставляются по скроллу (`CatalogGrid.astro`):
 * их кнопок в момент запуска скрипта еще не существует, и обход
 * `querySelectorAll` их не увидел бы. Делегирование работает независимо
 * от того, когда узел появился.
 */
document.addEventListener("click", (event) => {
	const target = event.target;
	if (!(target instanceof Element)) return;

	const button = target.closest<HTMLButtonElement>("[data-save-button]");
	if (button) toggle(button);
});

syncButtons([document.body]);

/*
 * Состояние - вторая половина той же проблемы: подгруженная карточка
 * приезжает из шаблона с `aria-pressed="false"`, даже если проект уже в
 * закладках. Наблюдатель проставляет его в момент вставки.
 */
const observer = new MutationObserver((records) => {
	const added: Element[] = [];

	for (const record of records) {
		for (const node of record.addedNodes) {
			if (node instanceof Element) added.push(node);
		}
	}

	if (added.length > 0) syncButtons(added);
});

observer.observe(document.body, { childList: true, subtree: true });
</script>
