---
import {
	type Category,
	categoryLabel,
	categoryTone,
	type Tag,
	tagLabel,
} from "@/lib/taxonomy";
import { TONE_CLASSES } from "@/lib/ui/tone";
import type { LocaleCode } from "@/config/types";
import { cn } from "cn";

/**
 * Чип категории или тега - один источник вида для карточки и страницы
 * проекта. Раньше та же пилюля была расписана в `CatalogCard` и
 * `CardTaxonomy` по отдельности, и паддинги с hover успели разъехаться.
 *
 * `href` делает чип ссылкой с hover; без него это просто `<span>`
 * (в карточке ссылкой служит сама карточка). `size="sm"` - плотный
 * вариант для карточки, тот же прием, что у `PeopleBadge`.
 *
 * Категория - контурная пилюля с точкой в тон категории; тег - тихая
 * плашка с решеткой. Иконка категории в чип больше не входит: на 12px
 * она превращалась в пятно, а цвет точки узнается и так.
 */

type Props = {
	locale: LocaleCode;
	size?: "sm" | "md";
	href?: string | undefined;
} & ({ kind: "category"; value: Category } | { kind: "tag"; value: Tag });

const { locale, size = "md", href, kind, value } = Astro.props;

const padding = size === "sm" ? "px-2 py-0.5" : "px-2.5 py-1";

const chipClass =
	kind === "category"
		? cn(
				"inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-background text-muted-foreground text-xs ring-1 ring-border-strong ring-inset",
				padding,
				href && "transition hover:bg-muted hover:text-foreground",
			)
		: cn(
				"inline-block whitespace-nowrap rounded-full bg-muted text-muted-foreground text-xs",
				padding,
				href && "transition hover:bg-border hover:text-foreground",
			);

const Element = href ? "a" : "span";
---

<Element href={href} class={chipClass}>
	{
		kind === "category" ? (
			<>
				<span
					class={cn("size-1.5 shrink-0 rounded-full", TONE_CLASSES[categoryTone(value)].dot)}
					aria-hidden="true"
				/>
				{categoryLabel(locale, value)}
			</>
		) : (
			`#${tagLabel(locale, value)}`
		)
	}
</Element>
