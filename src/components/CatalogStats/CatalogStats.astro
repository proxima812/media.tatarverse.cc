---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { driftVars, resolveLogos } from "@/components/CatalogStats/logos";
import type { LocaleCode } from "@/config/types";
import { usePlural, useTranslations } from "@/i18n";

interface Props {
	locale: LocaleCode;
	cards: CollectionEntry<"cards">[];
}

const { locale, cards } = Astro.props;

const t = useTranslations(locale);
const plural = usePlural(locale);
const number = new Intl.NumberFormat(locale);

/*
 * Цифры считаются из коллекции, а не хранятся в словаре: карточки добавляются
 * пулл-реквестами, и вручную поддерживаемое число устарело бы в первый же день.
 */
const stats = [
	{ key: "stats.projects", value: cards.length },
	{
		key: "stats.tags",
		value: new Set(cards.flatMap((c) => c.data.tags)).size,
	},
	{
		key: "stats.peoples",
		value: new Set(cards.flatMap((c) => c.data.peoples)).size,
	},
];

/** Подборка и позиции - в `logos.ts`, там же их и менять. */
const logos = resolveLogos(cards);

/** Максимальный css-размер логотипа (`--logo-size`) - от него считается исходник. */
const BASE_PX = 80;
/**
 * Минимальный зазор центра логотипа от края секции: логотип ставится по
 * центру (x/y - координаты центра), поэтому ему нужна половина своего
 * размера, а дрейфу - еще немного сверху. Без этого зазора логотипы у края
 * задевали бы границу секции, и `overflow: hidden` обрезал бы их пополам.
 *
 * Раньше этот отступ был `inset` на обертке - то есть сжимал саму систему
 * координат, и `slot.x`/`slot.y` из `logos.ts` (снятые с референса как %
 * от целой секции) съезжали к центру. Теперь обертка растянута на всю
 * секцию (`inset: 0`), а зазор применяется точечно через `clamp()` - он
 * подстраховывает только координаты, которые реально уходят к краю.
 */
const SAFE_INSET = "calc(var(--logo-size) / 2 + 14px)";
---

<section
	class="relative -mx-5 overflow-hidden px-5"
	style="--logo-size: clamp(2.25rem, 6vw, 4.5rem)"
>
	<div
		class="grid min-h-[28rem] place-items-center py-16 sm:min-h-[34rem] lg:min-h-[40rem]"
	>
		<div class="pointer-events-none absolute inset-0" aria-hidden="true">
			{logos.map(({ slot, card }) => {
					const size = `calc(var(--logo-size) * ${slot.scale})`;
					const left = `clamp(${SAFE_INSET}, ${slot.x}%, calc(100% - ${SAFE_INSET}))`;
					const top = `clamp(${SAFE_INSET}, ${slot.y}%, calc(100% - ${SAFE_INSET}))`;

					return (
						<div
							class="absolute -translate-x-1/2 -translate-y-1/2"
							style={`left:${left};top:${top};width:${size};height:${size}`}
						>
							<div class="drift h-full w-full" style={driftVars(slot.id)}>
								<Image
									src={card.data.logo}
									alt=""
									width={Math.round(BASE_PX * slot.scale)}
									height={Math.round(BASE_PX * slot.scale)}
									densities={[1, 2]}
									format="webp"
									class="corner-squircle h-full w-full rounded-full border border-border bg-background object-cover shadow-lg shadow-black/5"
								/>
							</div>
						</div>
					);
				})}
		</div>

		<div class="relative text-center">
			<p class="font-medium text-muted-foreground text-sm sm:text-base">
				{t("stats.label")}
			</p>
			<ul
				class="mt-3 space-y-1 font-bold text-4xl tracking-tight sm:text-6xl lg:text-8xl"
			>
				{stats.map((stat) => (
						<li>
							<span class="tabular-nums">{number.format(stat.value)}</span>{" "}
							{plural(stat.key, stat.value)}
						</li>
					))}
			</ul>
		</div>
	</div>
</section>

<style>
/*
	 * Хаотичное движение «на месте»: три точки траектории приходят инлайновыми
	 * переменными (`logos.ts`), поэтому один @keyframes обслуживает все
	 * логотипы, а разными их делают длительность и отрицательная задержка.
	 * Анимируется только transform - без layout и paint.
	 */
.drift {
	animation: drift var(--drift-duration) ease-in-out var(--drift-delay) infinite;
	will-change: transform;
}

@keyframes drift {
	0%,
	100% {
		transform: translate3d(0, 0, 0) rotate(0deg);
	}
	25% {
		transform: translate3d(var(--dx-1), var(--dy-1), 0) rotate(var(--rot-1));
	}
	50% {
		transform: translate3d(var(--dx-2), var(--dy-2), 0) rotate(var(--rot-2));
	}
	75% {
		transform: translate3d(var(--dx-3), var(--dy-3), 0) rotate(var(--rot-3));
	}
}

@media (prefers-reduced-motion: reduce) {
	.drift {
		animation: none;
	}
}
</style>
