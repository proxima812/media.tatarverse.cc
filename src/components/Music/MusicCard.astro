---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import ArtistPhoto from "@/components/Music/ArtistPhoto.astro";
import type { Artist } from "@/lib/music/artists";
import type { LocaleCode } from "@/config/types";
import { usePlural } from "@/i18n";

interface Props {
	artist: Artist;
	locale: LocaleCode;
}

const { artist, locale } = Astro.props;
const { name, photo, tracks } = artist.data;

const plural = usePlural(locale);
const href = getRelativeLocaleUrl(locale, `catalog/music/${artist.id}`);

/*
 * Карточка музыки - не карточка проекта: здесь нет фактов, тегов и домена,
 * только кадр и имя. Поэтому вся карточка - одна ссылка, а не корпус с
 * двумя действиями внутри: кликать больше не во что.
 *
 * Имя стоит под кадром одной строкой (`truncate`), как подпись у обложек
 * проектов: ряды в сетке остаются одной высоты при любой длине имени, а
 * кадр не закрыт градиентом.
 */
---

<a
	href={href}
	class="group flex flex-col gap-3 rounded-md focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-4"
>
	<div
		class="aspect-[3/4] w-full overflow-hidden rounded-md corner-squircle bg-muted ring-1 ring-foreground/6 ring-inset"
	>
		<ArtistPhoto
			name={name}
			photo={photo}
			class="transition-transform duration-300 ease-snappy motion-safe:group-hover:scale-[1.03]"
		/>
	</div>

	<div class="flex items-start justify-between gap-3">
		<div class="min-w-0">
			<h2 class="truncate font-medium text-foreground tracking-[-0.01em]">{name}</h2>
			{tracks.length > 0 && (
				<p class="mt-0.5 font-mono text-faint text-xs">
					{tracks.length} {plural("music.tracks", tracks.length)}
				</p>
			)}
		</div>

		<Icon
			name="tabler:arrow-up-right"
			class="mt-0.5 size-4 shrink-0 text-faint transition duration-200 ease-snappy group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground"
			aria-hidden="true"
		/>
	</div>
</a>
