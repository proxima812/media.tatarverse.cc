---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import bashkirIcon from "@/assets/images/svg/bash.svg";
import crimeanTatarIcon from "@/assets/images/svg/qrim.svg";
import tatarIcon from "@/assets/images/svg/tat.svg";
import Button from "@/components/ui/Button.astro";
import type { LocaleCode } from "@/config/types";
import { usePlural, useTranslations } from "@/i18n";
import { cn } from "cn";

/**
 * Первый экран главной - журнальный заголовок: язык проектов назван словом,
 * а перед каждым словом стоит знак народа в цветном квадрате. Знаки
 * встроены в строку и масштабируются вместе с текстом (`em`), поэтому
 * заголовок переносится как обычный текст на любой ширине.
 *
 * Знак в строке - декор: язык уже назван словом рядом, поэтому `alt` пуст,
 * а для скринридера заголовок читается как обычная фраза.
 */
interface Props {
	locale: LocaleCode;
	/** Сколько карточек в каталоге - для подзаголовка. */
	count: number;
}

const { locale, count } = Astro.props;
const t = useTranslations(locale);
const plural = usePlural(locale);
const number = new Intl.NumberFormat(locale);

/*
 * Тон квадрата - из тех же токенов, что у категорий, но здесь он ничего не
 * кодирует: три разных цвета нужны, чтобы три знака не слились в одну
 * полосу. Задержки - лесенка по 80ms после заголовка.
 */
const signs = {
	tatar: { icon: tatarIcon, tone: "bg-tone-blue", delay: "[animation-delay:160ms]" },
	bashkir: { icon: bashkirIcon, tone: "bg-tone-green", delay: "[animation-delay:240ms]" },
	"crimean-tatar": {
		icon: crimeanTatarIcon,
		tone: "bg-tone-amber",
		delay: "[animation-delay:320ms]",
	},
} as const;

/*
 * Скругление квадрата - в `em`, а не из шкалы радиусов: квадрат растет
 * вместе с кеглем заголовка (от 44 до 104px), и фиксированный радиус на
 * крупном кегле превращал бы его в почти острый угол.
 */
const signClass =
	"mx-[0.06em] inline-grid size-[0.78em] place-items-center rounded-[0.2em] align-[-0.06em] shadow-[inset_0_1px_0_rgb(255_255_255/0.25)] motion-safe:animate-pop";
---

<section class="pt-4 sm:pt-8">
	<h1
		class="max-w-[15ch] font-semibold text-[clamp(2.75rem,7.4vw,6.5rem)] text-foreground leading-[0.96] tracking-[-0.06em] motion-safe:animate-rise"
	>
		{t("home.hero.lead")}
		<span class={cn(signClass, signs.tatar.tone, signs.tatar.delay)}>
			<img src={signs.tatar.icon.src} alt="" width="64" height="64" class="size-[62%]" />
		</span>{t("home.hero.tatar")}
		<span class={cn(signClass, signs.bashkir.tone, signs.bashkir.delay)}>
			<img src={signs.bashkir.icon.src} alt="" width="64" height="64" class="size-[62%]" />
		</span>{t("home.hero.bashkir")}
		<span class="text-faint">{t("home.hero.and")}</span>
		<span
			class={cn(signClass, signs["crimean-tatar"].tone, signs["crimean-tatar"].delay)}
		>
			<img
				src={signs["crimean-tatar"].icon.src}
				alt=""
				width="64"
				height="64"
				class="size-[62%]"
			/>
		</span>{t("home.hero.crimean")}
	</h1>

	<div
		class="mt-8 flex flex-wrap items-end justify-between gap-6 motion-safe:animate-rise motion-safe:[animation-delay:120ms]"
	>
		<p class="max-w-[46ch] text-lg text-muted-foreground leading-relaxed text-pretty">
			<span class="font-medium text-foreground">
				{number.format(count)} {plural("stats.projects", count)}
			</span>
			{t("home.hero.sub")}
		</p>
		<Button href={getRelativeLocaleUrl(locale, "catalog")} preset="solid" size="lg">
			{t("home.hero.all")}
			<Icon name="tabler:arrow-right" class="size-4" aria-hidden="true" />
		</Button>
	</div>
</section>
