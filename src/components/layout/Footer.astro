---
import { getRelativeLocaleUrl } from "astro:i18n";
import FooterLinkGroup from "@/components/layout/FooterLinkGroup.astro";
import Tooltip from "@/components/ui/Tooltip.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * «Разделы» - полная карта сайта, а не сокращенный набор из шапки: подвал
 * читают именно тогда, когда нужного пункта в шапке не нашлось, и обрезанный
 * список там бесполезен. Правовые страницы живут отдельной строкой внизу.
 */
const sectionLinks = [
	{ href: getRelativeLocaleUrl(locale, "catalog"), label: t("nav.catalog") },
	{ href: getRelativeLocaleUrl(locale, "search"), label: t("nav.search") },
	{ href: getRelativeLocaleUrl(locale, "saved"), label: t("nav.saved") },
];

/*
 * «Полезное» - страницы о самом каталоге, а не его содержимом: их читают
 * один раз и по своей причине, поэтому в списке разделов они только
 * разбавляли бы навигацию по данным.
 */
const usefulLinks = [
	{ href: getRelativeLocaleUrl(locale, "about"), label: t("nav.about") },
	{ href: getRelativeLocaleUrl(locale, "add"), label: t("nav.add") },
];

/*
 * Соцсети и связь - те же аккаунты, что в подвале tatarverse.cc: у проектов
 * одна редакция, и разводить их по разным аккаунтам значит терять читателя
 * на переходе между сайтами. Иконки - `mdi`, потому что у него есть все
 * четыре площадки; `tabler:brand-threads` - вынужденное исключение, у mdi
 * Threads нет. Добавляя площадку, сначала ищите ее в `mdi`.
 *
 * Видимая подпись - точный хендл, а не имя площадки: его копируют и ищут
 * по нему. Площадку показывает иконка, а для скринридера она уходит в
 * `aria-label` - иначе он прочитает четыре одинаковых «эт-the_tatarverse».
 */
const socialLinks = [
	{
		href: "https://t.me/the_tatarverse",
		network: "Telegram",
		label: "@the_tatarverse",
		icon: "mdi:telegram",
	},
	{
		href: "https://vk.ru/the_tatarverse",
		network: "VK",
		label: "the_tatarverse",
		icon: "mdi:vk",
	},
	{
		href: "https://instagram.com/the_tatarverse",
		network: "Instagram",
		label: "@the_tatarverse",
		icon: "mdi:instagram",
	},
	{
		href: "https://www.threads.com/@the_tatarverse",
		network: "Threads",
		label: "@the_tatarverse",
		icon: "tabler:brand-threads",
	},
];

/*
 * Третья колонка - два коротких блока. «Материал» про сам сайт: исходники
 * открыты, их проверяют и форкают. «Экосистема» - соседние проекты; их
 * держим порознь, иначе «открытый код» читается как еще один сайт рядом.
 */
const materialLinks = [
	{
		href: "https://github.com/proxima812/media.tatarverse.cc",
		network: "GitHub",
		label: t("footer.openSource"),
		icon: "mdi:github",
	},
];

const ecosystemLinks = [
	{
		href: "https://tatarverse.cc",
		network: "tatarverse.cc",
		label: "tatarverse.cc",
		icon: "mdi:world",
	},
];

/*
 * «Сотрудничество» - прямая почта редакции: у соцсетей и issue разная
 * аудитория, а предложение о совместной работе пишут письмом.
 */
const collaborationLinks = [
	{
		href: "mailto:kamil.mirikhan@gmail.com",
		network: "Email",
		label: t("footer.writeEmail"),
		icon: "mdi:email-outline",
	},
];

/*
 * Связь - под «Разделами», отдельным блоком: это одна строка, не колонка.
 * Это тот же аккаунт, что первым идет в соцсетях, поэтому берем сам элемент,
 * а не копию: иначе один хендл разъезжается в подписи между двумя блоками.
 * Почта - не здесь, а в «Сотрудничестве»: сюда приходят с вопросом по
 * каталогу, а письмо пишут по другому поводу.
 */
const contactLinks = socialLinks.slice(0, 1);

/**
 * Правовые страницы - тут вместо статичной строки «Все права защищены»:
 * текст ничего не дает посетителю, а ссылка на реальный документ дает.
 */
const legalLinks = [
	{ href: getRelativeLocaleUrl(locale, "privacy"), label: t("nav.privacy") },
	{ href: getRelativeLocaleUrl(locale, "terms"), label: t("nav.terms") },
	{ href: getRelativeLocaleUrl(locale, "sources"), label: t("nav.sources") },
];

/** Год - на билде, не в браузере: страница статическая, значение одно для всех. */
const year = new Date().getFullYear();

const linkClass = "text-muted-foreground transition hover:text-foreground";

/*
 * Три колонки навигации, в каждой - одна-две группы «заголовок + список».
 * Сама группа отрисовывается в `FooterLinkGroup.astro`, здесь остаются
 * только данные и порядок.
 */
const columns = [
	{
		label: t("footer.sections"),
		groups: [
			{ heading: t("footer.sections"), links: sectionLinks },
			{ heading: t("footer.contact"), links: contactLinks },
		],
	},
	{
		label: t("footer.social"),
		groups: [
			{ heading: t("footer.social"), links: socialLinks },
			{ heading: t("footer.useful"), links: usefulLinks },
		],
	},
	{
		label: t("footer.material"),
		groups: [
			{ heading: t("footer.material"), links: materialLinks },
			{ heading: t("footer.ecosystem"), links: ecosystemLinks },
			{ heading: t("footer.collaboration"), links: collaborationLinks },
		],
	},
];
---

<!-- Подвал тихий: светлая подложка второго уровня и линия сверху вместо
     черной плиты с огромной надписью. Он закрывает страницу, а не
     соревнуется с ней - вся выразительность у заголовков выше. -->
<footer class="mt-24 border-border border-t bg-subtle text-sm">
	<div class="mx-auto max-w-7xl px-5 pt-14 pb-10">
		<div
			class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_auto_auto_auto] lg:gap-20"
		>
			<div class="max-w-sm space-y-4">
				<a
					href={getRelativeLocaleUrl(locale, "")}
					class="group relative inline-flex items-center gap-2.5 font-semibold text-[15px] text-foreground tracking-tight"
				>
					<img
						src="/media-tatarverse.svg"
						alt=""
						width="24"
						height="24"
						class="size-6 dark:brightness-0 dark:invert"
					/>
					media.tatarverse
					<Tooltip label={t("nav.home")} />
				</a>
				<p class="text-muted-foreground leading-relaxed">
					{t("meta.description")}
				</p>
				<p class="font-mono text-faint text-xs">MIT · CC BY 4.0</p>
			</div>

			{
				columns.map((column) => (
					<nav aria-label={column.label} class="lg:min-w-40">
						{column.groups.map((group, index) => (
							<FooterLinkGroup
								heading={group.heading}
								links={group.links}
								class={index > 0 ? "mt-8" : undefined}
							/>
						))}
					</nav>
				))
			}
		</div>

		<div
			class="mt-14 flex flex-col gap-3 border-border border-t pt-6 text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="font-mono text-faint text-xs">© {year} media.tatarverse</p>
			<nav aria-label={t("footer.legal")}>
				<ul class="flex flex-wrap gap-x-6 gap-y-2">
					{
						legalLinks.map((link) => (
							<li>
								<a href={link.href} class={linkClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</footer>
