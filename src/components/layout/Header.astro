---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import StrokeIcon from "@/components/ui/StrokeIcon.astro";
import Button from "@/components/ui/Button.astro";
import Tooltip from "@/components/ui/Tooltip.astro";
import type { LocaleCode } from "@/config/types";
import { locales, stripLocalePrefix, useTranslations } from "@/i18n";
import { cn } from "cn";

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const path = stripLocalePrefix(Astro.url.pathname);

interface NavLink {
	readonly href: string;
	readonly label: string;
	/**
	 * Знаковая ссылка - действие, а не раздел для чтения: в шапке она стоит
	 * справа иконкой с тултипом, в мобильной панели - строкой с подписью.
	 */
	readonly icon?: string;
	/**
	 * Знаковая ссылка, которая остается в шапке и на узком экране. Место там
	 * на одно действие: рядом название сайта и кнопка меню.
	 */
	readonly compact?: boolean;
	/** Показывать на иконке число сохраненных проектов. */
	readonly counter?: boolean;
}

const addHref = getRelativeLocaleUrl(locale, "add");

const navLinks: readonly NavLink[] = [
	{ href: getRelativeLocaleUrl(locale, "catalog"), label: t("nav.catalog") },
	{ href: getRelativeLocaleUrl(locale, "about"), label: t("nav.about") },
	{
		href: getRelativeLocaleUrl(locale, "search"),
		label: t("nav.search"),
		icon: "tabler:search",
		compact: true,
	},
	{
		href: getRelativeLocaleUrl(locale, "saved"),
		label: t("nav.saved"),
		icon: "tabler:bookmark",
		counter: true,
	},
];

const textLinks = navLinks.filter((link) => !link.icon);
const iconLinks = navLinks.filter((link): link is NavLink & { icon: string } =>
	Boolean(link.icon),
);

/*
 * Текущий раздел отмечается `aria-current="page"` - по нему подсвечивается
 * пункт и в шапке, и в панели. Сравнение идет по пути без префикса локали,
 * поэтому `/catalog` и `/en/catalog` считаются одним разделом.
 */
const isCurrent = (href: string) => stripLocalePrefix(href) === path;
const currentAttr = (href: string) => (isCurrent(href) ? "page" : undefined);

const navLinkClass =
	"whitespace-nowrap rounded-xs px-2.5 py-1.5 text-muted-foreground text-sm transition-colors duration-150 hover:bg-muted hover:text-foreground aria-[current=page]:text-foreground";

/*
 * Знаковая ссылка. 44px - минимальная тач-цель; от `sm` - 36px, там ведет
 * мышь. Подпись живет в `sr-only` и в тултипе.
 */
const iconLinkClass =
	"group relative grid size-11 shrink-0 place-items-center rounded-full text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground active:bg-muted aria-[current=page]:text-foreground sm:size-9";

/*
 * Геометрия шапки - две переменные на шапке и на панели меню: высота строки
 * и высота самой шапки, от которой панель отсчитывает свой верх. Панель
 * лежит рядом с шапкой, а не внутри нее, поэтому переменные ставятся
 * инлайном на оба элемента - наследовать их панели не от кого.
 */
const NAVBAR_VARS = "--navbar-height:64px";

/*
 * `active:bg-muted` - подсветка нажатия для пальца: у `html` системный
 * отклик на тап выключен, а `hover` на тач-экране не наступает.
 */
const menuNavLinkClass =
	"flex items-center gap-3 rounded-sm px-3 py-3 font-medium text-base text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:bg-muted aria-[current=page]:text-foreground";

const localeOptions = locales.map((code) => ({
	code,
	href: getRelativeLocaleUrl(code, path),
	label: code.toUpperCase(),
	/** Подпись под переключателем - название языка целиком, а не код. */
	title: t(`locale.${code}`),
}));
---

<!-- Шапка во всю ширину, как у журнала: строка на линии, а не плавающая
     пилюля. Липкая (`sticky`), поэтому не нужна распорка под ней - место в
     потоке она занимает сама. Подложка полупрозрачная с размытием: при
     прокрутке под ней видно содержимое, но текст ссылок читается.

     Порядок слева направо: знак и имя, разделы, затем справа действия -
     поиск, сохраненное, язык и единственная сплошная кнопка «Добавить
     проект». Цель каталога - рост, поэтому добавление всегда на виду. -->
<header
	data-header
	data-menu-open="false"
	style={NAVBAR_VARS}
	class="sticky top-0 z-50 border-border border-b bg-background/80 backdrop-blur-md"
>
	<div
		class="mx-auto flex h-[var(--navbar-height)] max-w-7xl items-center gap-2 px-5 sm:gap-6"
	>
		<!-- `min-w-0` + `truncate` - страховка на 320px (`min-w-80` у `body`):
		     там название упирается в кнопки, и лучше ему обрезаться, чем
		     вытолкнуть их за край. -->
		<a
			href={getRelativeLocaleUrl(locale, "")}
			class="flex min-w-0 shrink items-center gap-2.5 sm:shrink-0"
		>
			<img
				src="/media-tatarverse.svg"
				alt=""
				width="24"
				height="24"
				class="size-6 shrink-0"
			>
			<span class="truncate font-semibold text-[15px] text-foreground tracking-tight">media.tatarverse</span>
		</a>

		<nav class="hidden items-center gap-0.5 sm:flex" aria-label={t("nav.menu")}>
			{textLinks.map((link) => (
					<a
						href={link.href}
						aria-current={currentAttr(link.href)}
						class={navLinkClass}
					>
						{link.label}
					</a>
				))}
		</nav>

		<div class="ms-auto flex shrink-0 items-center gap-1 sm:gap-2">
			{iconLinks.map((link) => (
					<a
						href={link.href}
						aria-current={currentAttr(link.href)}
						class={cn(iconLinkClass, link.compact ? "grid" : "hidden sm:grid")}
					>
						<Icon name={link.icon} class="size-[1.125rem]" aria-hidden="true" />
						<span class="sr-only">{link.label}</span>
						<Tooltip label={link.label} class="hidden sm:block" />

						{link.counter && (
							<span
								data-saved-count
								hidden
								class="-top-0.5 -right-0.5 absolute flex h-4 min-w-4 items-center justify-center rounded-full bg-foreground px-1 font-mono font-semibold text-[10px] text-background leading-none ring-2 ring-background"
							/>
						)}
					</a>
				))}

			<div
				class="hidden shrink-0 items-center gap-0.5 rounded-full bg-muted p-0.5 sm:flex"
			>
				{localeOptions.map((option) => (
						<a
							href={option.href}
							aria-current={option.code === locale ? "true" : undefined}
							class={cn(
								"group relative rounded-full px-2.5 py-1 font-medium font-mono text-[11px] transition-colors",
								option.code === locale
									? "bg-background text-foreground shadow-xs"
									: "text-muted-foreground hover:text-foreground",
							)}
						>
							{option.label}
							<Tooltip label={option.title} class="mt-3" />
						</a>
					))}
			</div>

			<Button
				href={addHref}
				preset="solid"
				size="sm"
				aria-current={currentAttr(addHref)}
				class="hidden sm:inline-flex"
			>
				{t("nav.add")}
			</Button>

			<Button
				preset="ghost"
				size="icon"
				data-menu-button
				data-open="false"
				aria-expanded="false"
				aria-controls="header-menu"
				class="group size-11 sm:hidden"
			>
				<span class="sr-only">{t("nav.menu")}</span>
				<!-- Шеврон, а не бургер: рядом стоит знак-действие, и второй
				     такой же знак читался бы как еще одно действие. Поворот
				     висит на `data-open` кнопки. -->
				<StrokeIcon
					name="chevron"
					size={20}
					class="transition-transform duration-200 ease-snappy group-data-[open=true]:rotate-180"
				/>
			</Button>
		</div>
	</div>
</header>

<!--
	Мобильная панель - лист во всю ширину прямо под шапкой. Лежит рядом с
	шапкой, а не внутри: `backdrop-filter` шапки заводит контейнер для
	`fixed`-потомков, и панель внутри считалась бы от нее.

	Раскрытие - `grid-template-rows` от `0fr` к `1fr`: высота у листа по
	содержимому, а `height: auto` не анимируется. Внутренняя обертка обязана
	иметь `min-h-0`, иначе трек в `0fr` не сожмет ее ниже min-content.

	`visibility` в списке переходов намеренно: закрытая панель недоступна с
	клавиатуры, а без перехода она пропадала бы мгновенно и закрытия никто
	бы не видел. Вход 300ms на сильной ease-out, выход быстрее - 200ms.
-->
<div
	id="header-menu"
	data-menu-panel
	data-open="false"
	style={NAVBAR_VARS}
	class="invisible fixed inset-x-0 top-[var(--navbar-height)] z-40 grid max-h-[calc(100dvh-var(--navbar-height))] grid-rows-[0fr] overflow-hidden border-border border-b bg-background/95 opacity-0 backdrop-blur-md transition-[grid-template-rows,opacity,visibility] duration-200 ease-snappy data-[open=true]:visible data-[open=true]:grid-rows-[1fr] data-[open=true]:opacity-100 data-[open=true]:duration-300 sm:hidden"
>
	<div class="min-h-0 overflow-y-auto overscroll-contain px-3 py-3">
		<nav class="flex flex-col" aria-label={t("nav.menu")}>
			{navLinks.map((link) => (
					<a
						href={link.href}
						aria-current={currentAttr(link.href)}
						class={menuNavLinkClass}
					>
						{link.label}

						{link.counter && (
							<span
								data-saved-count
								hidden
								class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-foreground px-1.5 font-mono font-semibold text-[11px] text-background leading-none"
							/>
						)}
					</a>
				))}
		</nav>

		<div class="mt-3 grid gap-3 border-border border-t pt-3">
			<Button href={addHref} preset="solid" size="lg" block>
				{t("nav.add")}
			</Button>

			<div class="flex items-center gap-0.5 rounded-full bg-muted p-1">
				{localeOptions.map((option) => (
						<a
							href={option.href}
							aria-current={option.code === locale ? "true" : undefined}
							class={cn(
								"flex-1 rounded-full px-3 py-2.5 text-center font-medium text-sm transition-colors",
								option.code === locale
									? "bg-background text-foreground shadow-xs"
									: "text-muted-foreground hover:text-foreground active:bg-background/60",
							)}
						>
							{option.title}
						</a>
					))}
			</div>
		</div>
	</div>
</div>

<script>
/*
 * Счетчик сохраненного на иконке в шапке. Число живет в том же
 * `localStorage`, что и сами закладки (`SaveButton.astro`), поэтому шапка
 * его только читает: своего состояния у нее нет и рассинхронизироваться
 * ей не с чем.
 *
 * Три источника обновления: загрузка страницы, `catalog:saved-change`
 * (клик по сердечку в этой же вкладке) и `storage` - если закладку сняли
 * в соседней вкладке, шапка здесь не должна показывать старое число.
 *
 * Ноль не показывается: пустой бейдж - это шум, а не информация.
 */
import { onSavedChange, readSaved, SAVED_KEY } from "@/lib/catalog/savedStore";

function renderSavedCount() {
	const count = readSaved().length;

	for (const badge of document.querySelectorAll<HTMLElement>(
		"[data-saved-count]",
	)) {
		badge.textContent = String(count);
		badge.hidden = count === 0;
	}
}

renderSavedCount();
onSavedChange(renderSavedCount);
window.addEventListener("storage", (event) => {
	if (event.key === null || event.key === SAVED_KEY) renderSavedCount();
});

/*
 * Мобильное меню повторяет устройство `NavbarMenu` из HeroUI:
 *
 *   - состояние одно и живет в `data-open` на кнопке и на слое меню; вся
 *     анимация и видимость висят на этом атрибуте в классах, скрипт только
 *     переключает его (у HeroUI это `data-open` из `NavbarMenuToggle` и
 *     `NavbarMenu`, расставленные из общего контекста);
 *   - на шапке дополнительно `data-menu-open` - там по нему усиливают
 *     размытие подложки, здесь он открыт для тех же целей;
 *   - `aria-expanded` дублирует состояние для скринридера;
 *   - пока меню открыто, страница под ним не прокручивается
 *     (`usePreventScroll` у них, `overflow: hidden` на `html` здесь);
 *   - меню закрывается по Escape, по клику мимо, по переходу по ссылке и при
 *     расширении окна до `sm`: слой `sm:hidden`, и оставленное открытым
 *     состояние иначе пережило бы resize невидимым, но с заблокированной
 *     прокруткой.
 */
const SM_BREAKPOINT = "(min-width: 40rem)";

function setupMenu(header: HTMLElement) {
	const button = header.querySelector<HTMLButtonElement>("[data-menu-button]");
	const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
	if (!button || !panel) return;

	const isOpen = () => panel.dataset.open === "true";

	/*
	 * `overflow-x: clip` у `html` ставится в `tailwind.css` и нужен
	 * полноширинным блокам, поэтому на время блокировки он не затирается
	 * целиком - меняется только вертикальная ось.
	 */
	const lockScroll = (locked: boolean) => {
		document.documentElement.style.overflowY = locked ? "hidden" : "";
	};

	const setOpen = (open: boolean) => {
		panel.dataset.open = String(open);
		button.dataset.open = String(open);
		button.setAttribute("aria-expanded", String(open));
		header.dataset.menuOpen = String(open);
		lockScroll(open);
	};

	button.addEventListener("click", () => setOpen(!isOpen()));

	/* Переход по ссылке внутри меню - это уже уход со страницы: слой закрывается
	   сразу, иначе он останется поверх новой страницы во время навигации. */
	panel.addEventListener("click", (event) => {
		if (event.target instanceof Element && event.target.closest("a")) {
			setOpen(false);
		}
	});

	document.addEventListener("click", (event) => {
		if (
			isOpen() &&
			event.target instanceof Node &&
			!header.contains(event.target) &&
			!panel.contains(event.target)
		) {
			setOpen(false);
		}
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && isOpen()) {
			setOpen(false);
			button.focus();
		}
	});

	const desktop = window.matchMedia(SM_BREAKPOINT);

	desktop.addEventListener("change", (event) => {
		if (event.matches && isOpen()) setOpen(false);
	});
}

for (const header of document.querySelectorAll<HTMLElement>("[data-header]")) {
	setupMenu(header);
}

</script>
