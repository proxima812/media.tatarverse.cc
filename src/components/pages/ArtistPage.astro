---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import ArtistPhoto from "@/components/Music/ArtistPhoto.astro";
import MusicCard from "@/components/Music/MusicCard.astro";
import TrackList from "@/components/Music/TrackList.astro";
import type { Artist } from "@/lib/music/artists";
import type { PageLocale } from "@/lib/routes/pageLocale";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Button from "@/components/ui/Button.astro";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
	artist: Artist;
	others: Artist[];
}

const { locale, artist, others } = Astro.props;
const t = useTranslations(locale);
const {
	name,
	description,
	photo,
	links,
	photoCredit,
	photoCaption,
	photoLicense,
	photoLicenseUrl,
	photoSource,
} = artist.data;

const catalogHref = getRelativeLocaleUrl(locale, "catalog");
const musicHref = getRelativeLocaleUrl(locale, "catalog/music");

const metaDescription = description ?? `${name} - ${t("meta.music.artist")}`;
---

<Layout
	title={name}
	description={metaDescription}
>
	<div class="flex flex-wrap items-center gap-3">
		<Button href={musicHref} preset="ghost" size="sm" class="-ml-3">
			<Icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
			{t("music.back")}
		</Button>

		<Breadcrumbs
			locale={locale}
			items={[
				{ label: t("nav.catalog"), href: catalogHref },
				{ label: t("music.pageTitle"), href: musicHref },
				{ label: name },
			]}
			class="sm:ml-auto"
		/>
	</div>

	<!--
	     Слева - кадр и внешние площадки, справа - треки. На узком экране
	     колонки складываются в столбец, и фото остается первым: оно и есть
	     заглавие страницы.
	-->
	<div class="grid gap-12 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-start lg:gap-16">
		<aside class="lg:sticky lg:top-24">
			<div
				class="aspect-[3/4] w-full overflow-hidden rounded-lg corner-squircle bg-muted ring-1 ring-foreground/6 ring-inset"
			>
				<ArtistPhoto name={name} photo={photo} size="page" priority />
			</div>

			<!--
			     Подпись под фото - не украшение, а условие лицензии: снимки
			     с Викисклада под CC BY-SA можно ставить, только назвав автора
			     и лицензию. Нет данных об авторе - подписи нет (свое фото или
			     фото без требований к атрибуции).
			-->
			{photoCaption && (
				<p class="mt-3 text-faint text-xs">
					{photoSource ? (
						<a
							href={photoSource}
							target="_blank"
							rel="noopener noreferrer"
							class="underline underline-offset-2 hover:text-foreground"
						>
							{photoCaption}
						</a>
					) : (
						photoCaption
					)}
				</p>
			)}

			{photoCredit && (
				<p class="mt-1 text-faint text-xs">
					{t("music.photo.by")} {photoSource ? (
						<a
							href={photoSource}
							target="_blank"
							rel="noopener noreferrer"
							class="underline underline-offset-2 hover:text-foreground"
						>
							{photoCredit}
						</a>
					) : (
						photoCredit
					)}
					{photoLicense && (
						<>
							{", "}
							{photoLicenseUrl ? (
								<a
									href={photoLicenseUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="underline underline-offset-2 hover:text-foreground"
								>
									{photoLicense}
								</a>
							) : (
								photoLicense
							)}
						</>
					)}
				</p>
			)}

			{links.length > 0 && (
				<div class="mt-6 flex flex-wrap gap-1.5">
					{links.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group inline-flex h-8 items-center gap-1.5 rounded-full px-3 text-[13px] text-muted-foreground ring-1 ring-border-strong ring-inset transition duration-150 ease-snappy hover:bg-muted hover:text-foreground active:scale-[0.96] motion-reduce:active:scale-100"
						>
							{link.label}
							<Icon
								name="tabler:arrow-up-right"
								class="size-3.5 transition-transform duration-200 ease-snappy group-hover:-translate-y-px group-hover:translate-x-px"
								aria-hidden="true"
							/>
						</a>
					))}
				</div>
			)}
		</aside>

		<div class="flex flex-col gap-12">
			<div>
				<span class="mb-3 block font-medium font-mono text-faint text-xs uppercase tracking-wider">
					{t("music.pageTitle")}
				</span>
				<h1
					class="font-semibold text-[clamp(2.5rem,5.5vw,4.5rem)] text-balance text-foreground leading-[0.98] tracking-[-0.05em]"
				>
					{name}
				</h1>
				{description && (
					<p class="mt-5 max-w-2xl text-lg text-muted-foreground text-pretty">{description}</p>
				)}
			</div>

			<section class="flex flex-col gap-4">
				<div class="flex flex-wrap items-baseline justify-between gap-3">
					<h2 class="font-semibold text-foreground text-xl tracking-[-0.035em] sm:text-2xl">
						{t("music.popular")}
						{artist.data.tracks.length > 0 && (
							<span class="ms-1 font-mono font-normal text-faint text-sm">{artist.data.tracks.length}</span>
						)}
					</h2>
					<p class="text-faint text-xs">{t("music.copy.hint")}</p>
				</div>

				<TrackList artist={artist} locale={locale} />
			</section>
		</div>
	</div>

	{others.length > 0 && (
		<section class="border-border border-t pt-12">
			<div class="flex flex-wrap items-baseline justify-between gap-3">
				<h2 class="font-semibold text-2xl text-balance text-foreground tracking-[-0.035em] sm:text-3xl">
					{t("music.others")}
				</h2>
				<a
					href={musicHref}
					class="group inline-flex items-center gap-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
				>
					{t("music.all")}
					<Icon
						name="tabler:arrow-right"
						class="size-4 transition-transform duration-200 ease-snappy group-hover:translate-x-0.5"
						aria-hidden="true"
					/>
				</a>
			</div>

			<div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
				{others.map((other) => (
					<MusicCard artist={other} locale={locale} />
				))}
			</div>
		</section>
	)}
</Layout>
