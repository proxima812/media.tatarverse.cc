---
import { getCollection } from "astro:content";
import Catalog from "@/components/Catalog/Catalog.astro";
import { getAllCategories } from "@/lib/catalog/categories";
import { localizeCards } from "@/lib/catalog/localize";
import { sortByPubDate } from "@/lib/catalog/sort";
import type { PageLocale } from "@/lib/routes/pageLocale";
import { usePlural, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);
const plural = usePlural(locale);
const cards = sortByPubDate(
	await localizeCards(await getCollection("cards"), locale),
);
const categories = getAllCategories(cards);
---

<Layout
	title={t("catalog.pageTitle")}
	description={t("meta.catalog.description")}
>
	<!-- Заголовок страницы в журнальном масштабе: крупно, плотно, слева.
	     Счетчик - моноширинным справа, как подпись к таблице, а не плашкой. -->
	<div class="flex flex-wrap items-end justify-between gap-4">
		<h1
			class="font-semibold text-[clamp(2.5rem,5.5vw,4.5rem)] text-balance text-foreground leading-[0.98] tracking-[-0.05em]"
		>
			{t("catalog.pageTitle")}
		</h1>
		<p class="font-mono text-muted-foreground text-sm">
			<span class="text-foreground">{cards.length}</span>
			{plural("stats.projects", cards.length)}
		</p>
	</div>
	<Catalog locale={locale} cards={cards} categories={categories} />
</Layout>
