---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Catalog from "@/components/Catalog/Catalog.astro";
import { getAllCategories } from "@/lib/catalog/categories";
import { localizeCards } from "@/lib/catalog/localize";
import { sortByPubDate } from "@/lib/catalog/sort";
import type { PageLocale } from "@/lib/routes/pageLocale";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import CatalogFacetsPrototype from "@/components/Catalog/prototype/CatalogFacetsPrototype.astro";

interface Props {
	locale: PageLocale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);
const cards = sortByPubDate(
	await localizeCards(await getCollection("cards"), locale),
);
const categories = getAllCategories(cards);
---

<Layout
	title={t("catalog.pageTitle")}
	description={t("meta.catalog.description")}
>
	<div data-proto-current hidden={import.meta.env.DEV}>
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class="font-bold text-primary text-3xl text-balance sm:text-4xl">
			{t("catalog.pageTitle")}
		</h1>
		<div class="text-muted-foreground flex items-center space-x-2 font-medium">
			<Icon
				name="mdi:card-multiple-outline"
				class="size-4.5"
				aria-hidden="true"
			/>
			<span>{cards.length}</span>
		</div>
	</div>
	<Catalog locale={locale} cards={cards} categories={categories} />
	</div>
	{import.meta.env.DEV && locale === "ru" && <CatalogFacetsPrototype cards={cards} />}
</Layout>
