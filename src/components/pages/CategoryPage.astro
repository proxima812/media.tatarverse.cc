---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Catalog from "@/components/Catalog/Catalog.astro";
import { cardsByCategory } from "@/lib/catalog/categories";
import { sortByPubDate } from "@/lib/catalog/sort";
import type { Category } from "@/lib/taxonomy";
import { categoryLabel } from "@/lib/taxonomy";
import type { PageLocale } from "@/lib/routes/pageLocale";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import CategoryTile from "@/components/ui/CategoryTile.astro";
import { usePlural, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
	category: Category;
	cards: CollectionEntry<"cards">[];
	categories: Category[];
}

const { locale, category, cards, categories } = Astro.props;

const t = useTranslations(locale);
const plural = usePlural(locale);
const filtered = sortByPubDate(cardsByCategory(cards, category));

/** "Карточки по {категория} ({count})" - заголовок и `<title>` в одном месте. */
const heading = `${t("catalog.byCategoryPrefix")} ${categoryLabel(locale, category)} (${filtered.length})`;
const catalogHref = getRelativeLocaleUrl(locale, "catalog");

/** Описание страницы раздела: то же, что в заголовке, но фразой для выдачи. */
const metaDescription = `${t("meta.category.description")} ${categoryLabel(locale, category)}.`;
---

<Layout
	title={heading}
	description={metaDescription}
>
	<Breadcrumbs
		locale={locale}
		items={[
			{ label: t("nav.catalog"), href: catalogHref },
			{ label: categoryLabel(locale, category) },
		]}
	/>

	<!-- Заголовок категории: иконка в тон категории и название крупно. Слова
	     «Проекты в категории» остаются в `h1` строкой-ярлыком над названием -
	     так заголовок для поисковика и скринридера по-прежнему полный. -->
	<div class="flex flex-wrap items-end justify-between gap-4">
		<div class="flex items-end gap-4">
			<CategoryTile category={category} size="lg" class="mb-1.5" />
			<h1 class="text-foreground">
				<span class="mb-2 block font-medium text-muted-foreground text-base">
					{t("catalog.byCategoryPrefix")}
				</span>
				<span
					class="block font-semibold text-[clamp(2.5rem,5.5vw,4.5rem)] text-balance leading-[0.98] tracking-[-0.05em]"
				>
					{categoryLabel(locale, category)}
				</span>
			</h1>
		</div>
		<p class="text-muted-foreground text-sm tabular-nums">
			<span class="text-foreground">{filtered.length}</span>{" "}
			{plural("stats.projects", filtered.length)}
		</p>
	</div>
	<Catalog
		locale={locale}
		cards={filtered}
		categories={categories}
		activeCategory={category}
	/>

	{filtered.length === 0 && (
		<p class="mx-auto max-w-xl py-16 text-center text-lg text-muted-foreground">
			{t("catalog.category.empty")}
		</p>
	)}
</Layout>
