---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import Catalog from "@/components/Catalog/Catalog.astro";
import { cardsByCategory } from "@/lib/catalog/categories";
import { sortByPubDate } from "@/lib/catalog/sort";
import type { Category } from "@/lib/taxonomy";
import { categoryIcon, categoryLabel } from "@/lib/taxonomy";
import { ogLocale, type PageLocale } from "@/lib/routes/pageLocale";
import Breadcrumbs from "@/components/partials/Breadcrumbs.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
	category: Category;
	cards: CollectionEntry<"cards">[];
	categories: Category[];
}

const { locale, category, cards, categories } = Astro.props;

const t = useTranslations(locale);
const filtered = sortByPubDate(cardsByCategory(cards, category));

/** "Карточки по {категория} ({count})" - заголовок и `<title>` в одном месте. */
const heading = `${t("catalog.byCategoryPrefix")} ${categoryLabel(locale, category)} (${filtered.length})`;
const catalogHref = getRelativeLocaleUrl(locale, "catalog");

/** Описание страницы раздела: то же, что в заголовке, но фразой для выдачи. */
const metaDescription = `${t("meta.category.description")} ${categoryLabel(locale, category)}.`;
---

<Layout
	title={heading}
	description={metaDescription}
	htmlLang={locale}
	locale={ogLocale(locale)}
	alternates={buildAlternates(Astro.url.pathname)}
>
	<Breadcrumbs
		locale={locale}
		items={[
			{ label: t("nav.catalog"), href: catalogHref },
			{ label: categoryLabel(locale, category) },
		]}
		class="px-6"
	/>

	<div class="flex flex-wrap items-center justify-between gap-3 px-6">
		<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
			<h1 class="font-bold text-3xl text-balance sm:text-4xl">
				{t("catalog.byCategoryPrefix")}
			</h1>
			<div
				class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-muted/60 text-muted-foreground"
			>
				<Icon
					name={categoryIcon(category)}
					class="size-4.5 text-muted-foreground"
					aria-hidden="true"
				/>
				<span class=" text-muted-foreground"
					>{categoryLabel(locale, category)}</span
				>
			</div>
		</div>
		<div class="text-muted-foreground flex items-center space-x-2 font-medium">
			<Icon
				name="mdi:card-multiple-outline"
				class="size-4.5"
				aria-hidden="true"
			/>
			<span>{filtered.length}</span>
		</div>
	</div>

	<Catalog
		locale={locale}
		cards={filtered}
		categories={categories}
		activeCategory={category}
	/>
</Layout>
