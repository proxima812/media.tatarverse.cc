---
import { categoryIcon, categoryLabel } from "@/components/Catalog/taxonomy";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Catalog from "@/components/Catalog/Catalog.astro";
import { cardsByCategory } from "@/components/Catalog/categories";
import type { Category } from "@/components/Catalog/taxonomy";
import { ogLocale, type PageLocale } from "@/components/pages/pageLocale";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
	category: Category;
	cards: CollectionEntry<"cards">[];
	categories: Category[];
}

const { locale, category, cards, categories } = Astro.props;

const t = useTranslations(locale);
const filtered = cardsByCategory(cards, category);

/** "Карточки по {категория} ({count})" - заголовок и `<title>` в одном месте. */
const heading = `${t("catalog.byCategoryPrefix")} ${categoryLabel(locale, category)} (${filtered.length})`;
---

<Layout
	title={heading}
	htmlLang={locale}
	locale={ogLocale(locale)}
	alternates={buildAlternates(Astro.url.pathname)}
>
	<div class="px-6 flex justify-between items-center">
		<div class="flex space-x-6 items-center">
			<h1 class="font-bold text-3xl text-balance sm:text-4xl">
				{t("catalog.byCategoryPrefix")}
			</h1>
			<div
				class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-muted/60 text-muted-foreground"
			>
				<Icon
					name={categoryIcon(category)}
					class="size-4.5 text-muted-foreground"
					aria-hidden="true"
				/>
				<span class=" text-muted-foreground">{categoryLabel(locale, category)}</span>
			</div>
		</div>
		<div class="text-muted-foreground flex items-center space-x-2 font-medium">
			<Icon name="mdi:card-multiple-outline" class="size-4.5" aria-hidden="true" />
			<span>{filtered.length}</span>
		</div>
	</div>

	<Catalog
		locale={locale}
		cards={filtered}
		categories={categories}
		activeCategory={category}
	/>
</Layout>
