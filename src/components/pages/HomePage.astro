---
import { getCollection } from "astro:content";
import { localizeCards } from "@/lib/catalog/localize";
import { homeContent } from "@/lib/home/content";
import type { PageLocale } from "@/lib/routes/pageLocale";
import CategoryRows from "@/components/home/CategoryRows.astro";
import FAQ from "@/components/home/FAQ.astro";
import JournalHero from "@/components/home/JournalHero.astro";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);
const cards = await localizeCards(await getCollection("cards"), locale);
const content = homeContent(locale);

/** Markdown-двойник главной: `/index.md` для русской, `/en.md` для английской. */
const markdownURL = locale === "en" ? "/en.md" : "/index.md";
---

<Layout
	title={t("meta.title")}
	description={t("meta.description")}
	markdownURL={markdownURL}
>
	<!-- Главная «Журнал»: заголовок, ряды проектов по категориям и FAQ.
	     Больше ничего: каталог говорит сам за себя, а вопросы внизу
	     отвечают тем, кто дочитал. -->
	<JournalHero locale={locale} count={cards.length} />
	<CategoryRows locale={locale} cards={cards} />
	<FAQ title={content.faq.title} items={[...content.faq.items]} />
</Layout>
