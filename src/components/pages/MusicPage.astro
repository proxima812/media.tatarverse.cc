---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import MusicCard from "@/components/Music/MusicCard.astro";
import CatalogToolbar from "@/components/Catalog/CatalogToolbar.astro";
import CategoryTile from "@/components/ui/CategoryTile.astro";
import { getAllCategories } from "@/lib/catalog/categories";
import { localizeArtists, sortByName } from "@/lib/music/artists";
import type { PageLocale } from "@/lib/routes/pageLocale";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const artists = sortByName(
	localizeArtists(await getCollection("artists"), locale),
	locale,
);

/*
 * Переключатель категорий здесь тот же, что во всем каталоге: музыка -
 * раздел каталога, а не отдельный сайт, и уйти отсюда в «Медиа» или
 * «Авторов» надо тем же движением. Фильтра по тегам нет - у артиста нет
 * таксономии карточек.
 */
const categories = getAllCategories([]);
const catalogHref = getRelativeLocaleUrl(locale, "catalog");
---

<Layout
	title={t("music.pageTitle")}
	description={t("meta.music.description")}
>
	<Breadcrumbs
		locale={locale}
		items={[
			{ label: t("nav.catalog"), href: catalogHref },
			{ label: t("music.pageTitle") },
		]}
	/>

	<!-- Заголовок в масштабе страницы категории: иконка музыки в ее тоне,
	     название крупно, лид под ним, моноширинный счетчик артистов справа. -->
	<div class="flex flex-wrap items-end justify-between gap-4">
		<div class="flex flex-col gap-4">
			<div class="flex items-end gap-4">
				<CategoryTile category="music" size="lg" class="mb-1.5" />
				<h1
					class="font-semibold text-[clamp(2.5rem,5.5vw,4.5rem)] text-balance text-foreground leading-[0.98] tracking-[-0.05em]"
				>
					{t("music.pageTitle")}
				</h1>
			</div>
			<p class="max-w-2xl text-lg text-muted-foreground text-pretty">{t("music.lead")}</p>
		</div>
		<p class="inline-flex items-center gap-2 font-mono text-muted-foreground text-sm">
			<Icon name="tabler:music" class="size-4" aria-hidden="true" />
			<span class="text-foreground">{artists.length}</span>
		</p>
	</div>

	<CatalogToolbar
		locale={locale}
		categories={categories}
		activeCategory="music"
	/>

	<div
		class="grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
	>
		{artists.map((artist) => (
			<MusicCard artist={artist} locale={locale} />
		))}
	</div>
</Layout>
