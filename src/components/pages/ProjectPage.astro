---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import CardDetail from "@/components/Catalog/CardDetail.astro";
import CardTaxonomy from "@/components/Catalog/CardTaxonomy.astro";
import CatalogCard from "@/components/Catalog/CatalogCard.astro";
import { categoryLabel } from "@/lib/taxonomy";
import type { PageLocale } from "@/lib/routes/pageLocale";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Button from "@/components/ui/Button.astro";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
	card: CollectionEntry<"cards">;
	related: CollectionEntry<"cards">[];
}

const { locale, card, related } = Astro.props;
const t = useTranslations(locale);

/*
 * В крошках стоит первая категория карточки: порядок в фронтматтере
 * заводит человек, значит первая - главная по смыслу. Путь обязан быть
 * один, поэтому остальные категории сюда не попадают - они рядом,
 * пилюлями в самой карточке.
 */
const [mainCategory] = card.data.categories;
const catalogHref = getRelativeLocaleUrl(locale, "catalog");
const categoryHref = mainCategory
	? getRelativeLocaleUrl(locale, `catalog/${mainCategory}`)
	: undefined;
---

<Layout
	title={card.data.name}
	description={card.data.description}
>
	<div class="flex flex-wrap items-center gap-3">
		<Button href={catalogHref} preset="ghost" size="sm" class="-ml-3">
			<Icon name="tabler:arrow-left" class="size-4" aria-hidden="true" />
			{t("card.back")}
		</Button>
		<Breadcrumbs
			locale={locale}
			items={[
				{ label: t("nav.catalog"), href: catalogHref },
				...(mainCategory && categoryHref
					? [{ label: categoryLabel(locale, mainCategory), href: categoryHref }]
					: []),
				{ label: card.data.name },
			]}
			class="sm:ml-auto"
		/>
	</div>

	<!-- Две колонки: слева проект (обложка, заголовок, описание, факты),
	     справа узкая таблица свойств. Колонка свойств липнет под шапкой
	     (`top-24` = шапка 64px + воздух), пока читаются факты. -->
	<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-16">
		<CardDetail card={card} locale={locale} />
		<aside class="lg:sticky lg:top-24">
			<CardTaxonomy
				locale={locale}
				categories={card.data.categories}
				tags={card.data.tags}
				peoples={card.data.peoples}
			/>
		</aside>
	</div>

	{related.length > 0 && (
			<section class="border-border border-t pt-12">
				<div class="flex flex-wrap items-baseline justify-between gap-3">
					<h2 class="font-semibold text-2xl text-balance text-foreground tracking-[-0.035em] sm:text-3xl">
						{t("card.related")}
					</h2>
					{mainCategory && categoryHref && (
						<a
							href={categoryHref}
							class="group inline-flex items-center gap-1.5 text-muted-foreground text-sm transition-colors hover:text-foreground"
						>
							{t("card.allInCategory")} {categoryLabel(locale, mainCategory)}
							<Icon
								name="tabler:arrow-right"
								class="size-4 transition-transform duration-200 ease-snappy group-hover:translate-x-0.5"
								aria-hidden="true"
							/>
						</a>
					)}
				</div>
				<div class="mt-8 grid grid-cols-1 gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
					{related.map((relatedCard) => (
						<CatalogCard card={relatedCard} />
					))}
				</div>
			</section>
		)}
</Layout>
