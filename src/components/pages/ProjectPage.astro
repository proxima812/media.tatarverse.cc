---
import type { CollectionEntry } from "astro:content";
import CardDetail from "@/components/Catalog/CardDetail.astro";
import CatalogCard from "@/components/Catalog/CatalogCard.astro";
import { ogLocale, type PageLocale } from "@/components/pages/pageLocale";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
	card: CollectionEntry<"cards">;
	related: CollectionEntry<"cards">[];
}

const { locale, card, related } = Astro.props;
const t = useTranslations(locale);
---

<Layout
	title={card.data.name}
	description={card.data.description}
	htmlLang={locale}
	locale={ogLocale(locale)}
	alternates={buildAlternates(Astro.url.pathname)}
>
	<CardDetail card={card} locale={locale} />

	{related.length > 0 && (
			<section>
				<h2 class="text-center font-bold text-2xl text-balance">
					{t("card.related")}
				</h2>
				<div class="mt-8 grid gap-8 sm:grid-cols-3">
					{related.map((relatedCard) => (
						<CatalogCard card={relatedCard} />
					))}
				</div>
			</section>
		)}
</Layout>
