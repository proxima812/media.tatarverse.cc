---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import CatalogCard from "@/components/Catalog/CatalogCard.astro";
import { localizeCards } from "@/lib/catalog/localize";
import type { PageLocale } from "@/lib/routes/pageLocale";
import Button from "@/components/ui/Button.astro";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);

/*
 * `localizeCards` для русской локали возвращает список как есть, поэтому
 * вызов безусловный: раньше его помнили добавить только английские страницы,
 * и «не забыть не вызвать» было отдельным правилом для русских.
 */
const cards = await localizeCards(await getCollection("cards"), locale);

/*
 * Закладки живут только в localStorage - на сборке неизвестно, что сохранил
 * конкретный посетитель. Поэтому рендерятся все карточки сразу, каждая под
 * своим `data-saved-item`, и скрыты по умолчанию; скрипт открывает только
 * совпавшие с localStorage. Тот же прием, что у списочного вида каталога
 * (`CatalogList`) - разметка есть в DOM без запроса, а не догружается с сервера.
 */
---

<Layout
	title={t("saved.title")}
	description={t("meta.saved.description")}
	indexRobots={false}
>
	<div class="flex flex-wrap items-end justify-between gap-4">
		<h1
			class="font-semibold text-[clamp(2.5rem,5.5vw,4.5rem)] text-balance text-foreground leading-[0.98] tracking-[-0.05em]"
		>
			{t("saved.title")}
		</h1>
		<p class="inline-flex items-center gap-2 text-muted-foreground text-sm tabular-nums">
			<Icon name="tabler:bookmark" class="size-4" aria-hidden="true" />
			<span data-saved-visible class="text-foreground">0</span>
		</p>
	</div>

	<!-- Пустое состояние - на линиях, как остальные блоки, с той же иконкой
	     в тонированном квадрате, что у категорий: страница пустая, но не
	     выпадает из системы. -->
	<div
		data-saved-empty
		class="flex flex-col items-center gap-4 border-border border-y py-24 text-center"
	>
		<span class="grid size-12 place-items-center rounded-md corner-squircle bg-tone-blue/12 text-tone-blue ring-1 ring-tone-blue/24 ring-inset">
			<Icon name="tabler:bookmark" class="size-6" aria-hidden="true" />
		</span>
		<h2 class="font-semibold text-foreground text-xl tracking-[-0.035em]">
			{t("saved.empty.title")}
		</h2>
		<p class="max-w-sm text-muted-foreground text-sm text-pretty">
			{t("saved.empty.description")}
		</p>
		<Button href={getRelativeLocaleUrl(locale, "catalog")} preset="solid">
			{t("saved.empty.cta")}
			<Icon name="tabler:arrow-right" class="size-4" aria-hidden="true" />
		</Button>
	</div>

	<!--
		Та же сетка, что в каталоге (`CatalogGrid`): колонки гридом, карточки
		тянутся на всю высоту строки. `[&[hidden]]:hidden` обязателен -
		карточки прячутся атрибутом `hidden`, а `flex` в классе перебил бы
		его `display: none` из UA-стилей, и несохраненные проекты остались бы
		на экране.
	-->
	<div class="grid grid-cols-1 gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		{cards.map((card) => (
				<div data-saved-item={card.id} hidden class="flex [&[hidden]]:hidden">
					<CatalogCard card={card} />
				</div>
			))}
	</div>
</Layout>

<script>
import { onSavedChange, readSaved } from "@/lib/catalog/savedStore";

function render() {
	const saved = new Set(readSaved());
	const items = document.querySelectorAll<HTMLElement>("[data-saved-item]");
	let visible = 0;

	for (const item of items) {
		const isSaved = saved.has(item.dataset.savedItem ?? "");
		item.toggleAttribute("hidden", !isSaved);
		if (isSaved) visible += 1;
	}

	document
		.querySelector("[data-saved-empty]")
		?.toggleAttribute("hidden", visible > 0);

	/*
	 * У счетчика страницы свой атрибут: `[data-saved-count]` занят бейджем в
	 * шапке, и querySelector находил именно его - число страницы улетало в
	 * шапку, а та перезаписывала его своим правилом (общее число, ноль
	 * прячется). Смыслы у счетчиков разные: шапка считает все закладки,
	 * страница - видимые карточки.
	 */
	const count = document.querySelector("[data-saved-visible]");
	if (count) count.textContent = String(visible);
}

render();

/** Снятие закладки прямо на этой странице прячет карточку без перезагрузки. */
onSavedChange(render);
</script>
