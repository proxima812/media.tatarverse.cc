---
import { getCollection } from "astro:content";
import AlphabeticalCatalog from "@/components/search/AlphabeticalCatalog.astro";
import SearchInput from "@/components/search/SearchInput.astro";
import { localizeCards } from "@/lib/catalog/localize";
import type { PageLocale } from "@/lib/routes/pageLocale";
import { usePlural, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: PageLocale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);
const plural = usePlural(locale);
const cards = await localizeCards(await getCollection("cards"), locale);
---

<Layout
	title={t("nav.search")}
	description={t("meta.search.description")}
>
	<!-- Шапка страницы в масштабе каталога: крупный заголовок слева,
	     моноширинный счетчик справа, под ними большое поле. Указатель по
	     алфавиту идет следом и сам служит выдачей. -->
	<header class="flex flex-col gap-8">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<h1
				class="font-semibold text-[clamp(2.5rem,5.5vw,4.5rem)] text-balance text-foreground leading-[0.98] tracking-[-0.05em]"
			>
				{t("search.title")}
			</h1>
			<p class="font-mono text-muted-foreground text-sm">
				<span class="text-foreground">{cards.length}</span>
				{plural("stats.projects", cards.length)}
			</p>
		</div>

		<SearchInput locale={locale} />
	</header>

	<AlphabeticalCatalog locale={locale} cards={cards} />
</Layout>
