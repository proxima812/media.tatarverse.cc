---
import { cn } from "@/utils/lib/cn";

/**
 * Портировано из proxima-primitive (`BigWordBottom.astro`) - тот же прием
 * (растянутое слово + стопка `blur-layer` с растущим размытием, маскированных
 * градиентом, для плавного «утопания» в фон), но цвета и фон - токены этого
 * проекта (`--color-muted-foreground` → `--color-foreground`,
 * `--color-background`), а не сырые `zinc`/`white` оригинала.
 */

interface Props {
	class?: string;
	/**
	 * Классы-стопы Tailwind-градиента (`from-*`), не цвет текста (`text-*`):
	 * слово красится через `background-clip: text` из `bg-gradient-to-r`, у
	 * которого без `from-*`/`to-*` попросту нет цветов - тогда клипать нечего,
	 * и слово становится невидимым независимо от `color`.
	 */
	color1?: string;
	/** Классы-стоп градиента (`to-*`) - см. `color1`. */
	color2?: string;
	/**
	 * Куда «утопает» слово внизу: класс-стоп для градиента-заглушки
	 * (`after:to-*`). По умолчанию - фон страницы; на темной подложке
	 * (футер) сюда передается ее цвет, иначе низ слова упирается в светлую
	 * полосу вместо плавного схода в фон.
	 */
	fade?: string;
	/**
	 * Классы внешней обертки: полей и выхода за колонку контейнера. Живут
	 * снаружи, потому что зависят от места вставки - под темной плашкой
	 * футера нужен отступ, а не отрицательный, как в потоке страницы.
	 */
	wrap?: string;
	text?: string;
}

const {
	class: className,
	color1 = "from-muted-foreground",
	color2 = "to-foreground",
	fade = "after:to-background",
	wrap = "",
	text,
} = Astro.props;
---

<!--
	`z-index` тут намеренно не отрицательный. `-z-[1]` (как было) кладет блок в
	слой отрицательных z-index корневого контекста наложения, а фон `<body>`
	красится позже - слово оказывалось *за* фоном страницы и было не видно ни
	на одном экране. Эффект «утопания» дает не z-index, а градиент `after:` и
	стопка `blur-layer` поверх слова.
-->
<div
	class={cn(
		"relative px-5 after:absolute after:inset-0 after:h-full after:bg-linear-to-b after:from-transparent md:px-30",
		wrap,
		fade,
	)}
>
	<div class="overflow-hidden text-[clamp(1rem,90%,25rem)]">
		<div
			class={cn(
				`bg-clip-text bg-gradient-to-r text-transparent ${color1} ${color2} responsive-brand-text mx-auto text-center leading-[0.8] font-black uppercase max-md:py-5`,
				className,
			)}
		>
			{text || "text"}
		</div>
		<div
			class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[calc(50%+1.5rem)] w-full"
		>
			<div class="blur-layer blur-1 hidden md:block"></div>
			<div class="blur-layer blur-2 hidden md:block"></div>
			<div class="blur-layer blur-3 hidden md:block"></div>
			<div class="blur-layer blur-4"></div>
			<div class="blur-layer blur-5"></div>
			<div class="blur-layer blur-6"></div>
			<div class="blur-layer blur-7"></div>
		</div>
	</div>
</div>

<style>
	/* Общие стили слоев. */
	.blur-layer {
		position: absolute;
		inset: 0;
		mask-repeat: no-repeat;
		-webkit-mask-repeat: no-repeat;
	}

	/* Слои - по нарастанию размытия и z-index, каждый маскирован своей полосой. */
	.blur-1 {
		z-index: 70;
		backdrop-filter: blur(1px);
		-webkit-mask-image: linear-gradient(
			rgba(0, 0, 0, 0),
			rgba(0, 0, 0, 1) 10%,
			rgba(0, 0, 0, 1) 30%,
			rgba(0, 0, 0, 0) 40%
		);
	}

	.blur-2 {
		z-index: 60;
		backdrop-filter: blur(2px);
		-webkit-mask-image: linear-gradient(
			rgba(0, 0, 0, 0) 10%,
			rgba(0, 0, 0, 1) 20%,
			rgba(0, 0, 0, 1) 40%,
			rgba(0, 0, 0, 0) 50%
		);
	}

	.blur-3 {
		z-index: 50;
		backdrop-filter: blur(4px);
		-webkit-mask-image: linear-gradient(
			rgba(0, 0, 0, 0) 15%,
			rgba(0, 0, 0, 1) 30%,
			rgba(0, 0, 0, 1) 50%,
			rgba(0, 0, 0, 0) 60%
		);
	}

	.blur-4 {
		z-index: 40;
		backdrop-filter: blur(8px);
		-webkit-mask-image: linear-gradient(
			rgba(0, 0, 0, 0) 20%,
			rgba(0, 0, 0, 1) 40%,
			rgba(0, 0, 0, 1) 60%,
			rgba(0, 0, 0, 0) 70%
		);
	}

	.blur-5 {
		z-index: 30;
		backdrop-filter: blur(16px);
		-webkit-mask-image: linear-gradient(
			rgba(0, 0, 0, 0) 40%,
			rgba(0, 0, 0, 1) 60%,
			rgba(0, 0, 0, 1) 80%,
			rgba(0, 0, 0, 0) 90%
		);
	}

	.blur-6 {
		z-index: 20;
		backdrop-filter: blur(32px);
		-webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 1) 80%);
	}

	.blur-7 {
		z-index: 10;
		backdrop-filter: blur(52px);
		-webkit-mask-image: linear-gradient(rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 1) 100%);
	}
</style>

<script is:inline>
	function fitText(el, { min = 20, max = 400 } = {}) {
		if (!el?.parentElement) return;

		const parent = el.parentElement;

		const resize = () => {
			el.style.fontSize = `${max}px`;

			const ratio = parent.clientWidth / el.scrollWidth;
			const size = Math.max(min, Math.min(max, max * ratio));

			el.style.fontSize = `${size}px`;
		};

		const ro = new ResizeObserver(resize);
		ro.observe(parent);

		if (document.fonts) {
			document.fonts.ready.then(resize);
		}

		resize();
	}

	document.querySelectorAll(".responsive-brand-text").forEach((el) => {
		fitText(el, { min: 24, max: 500 });
	});
</script>
