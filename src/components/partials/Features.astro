---
import { Image } from "astro:assets";
import presentPhoto from "@/assets/images/main/present.png";
import videoLeft from "@/assets/video/p-v-1.mp4";
import videoRight from "@/assets/video/p-v-2.mp4";

interface Item {
	title: string;
	description: string;
}

interface Props {
	heading?: string;
	items?: Item[];
}

/*
 * Контент по умолчанию — не lorem ipsum, реальные шаги работы с каталогом
 * (см. тот же принцип в FAQ.astro). Средняя карточка — фото (`present.png`,
 * уже показанное в VideoShowcase): заглушка до появления отдельного
 * скриншота на этот шаг. Крайние — видео p-v-1/p-v-2.
 */
const {
	heading = "Один каталог — три способа его использовать.",
	items = [
		{
			title: "Смотрите весь каталог",
			description:
				"224 проекта о татарском, башкирском и крымскотатарском языках и культуре — с фильтрами по типу и языку.",
		},
		{
			title: "Открывайте карточку проекта",
			description:
				"Факты, ссылка на сайт и логотип — короткая выжимка о каждом проекте, без лишнего текста.",
		},
		{
			title: "Добавляйте свой проект",
			description:
				"Через pull request на GitHub — заполните карточку по образцу уже существующих и отправьте на ревью.",
		},
	],
} = Astro.props;

const VIDEOS = [videoLeft, undefined, videoRight] as const;
---

<section class="py-16">
	<h2 class="text-center font-black text-3xl text-balance sm:text-4xl">
		{heading}
	</h2>

	<div class="mt-12 grid gap-6 sm:grid-cols-3">
		{items.map((item, index) => (
				<div class="flex flex-col items-center text-center">
					<div class="aspect-square w-full overflow-hidden rounded-3xl corner-squircle bg-muted">
						{VIDEOS[index] ? (
							<video
								src={VIDEOS[index]}
								class="h-full w-full object-cover"
								loop
								muted
								playsinline
								autoplay
								preload="auto"
							/>
						) : (
							<Image
								src={presentPhoto}
								alt=""
								width={600}
								height={600}
								densities={[1, 2]}
								format="webp"
								class="h-full w-full object-cover object-center"
							/>
						)}
					</div>
					<p class="mt-6 font-semibold text-foreground text-lg">{item.title}</p>
					<p class="mt-2 text-muted-foreground text-sm">{item.description}</p>
				</div>
			))}
	</div>
</section>
