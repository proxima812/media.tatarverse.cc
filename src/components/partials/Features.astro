---
interface Item {
	title: string;
	description: string;
}

interface Props {
	heading?: string;
	items?: Item[];
}

/*
 * Контент по умолчанию - не lorem ipsum, реальные сценарии работы с
 * каталогом (см. тот же принцип в FAQ.astro). У каждой карточки своя
 * запись экрана: поиск (p-v-3), исходники на GitHub (p-v-2), сохранение
 * проекта в избранное (p-v-4). Порядок текстов и видео связан индексом,
 * поэтому переставлять их можно только вместе.
 *
 * Исходники записей лежат в `src/assets/video/original/` (в git не едут).
 * В репозитории - сжатые версии, 800×800/30, 0.3-0.9 МБ: в карточке видео
 * занимает меньше 400px, разницы не видно, а страница не весит как
 * дистрибутив.
 */
const {
	heading = "Все в одном каталоге - это удобно",
	items = [
		{
			title: "Находите за секунды",
			description:
				"Поиск по названию, описанию и тегам сужает каталог по мере ввода - а рядом весь список по алфавиту.",
		},
		{
			title: "Все открыто на GitHub",
			description:
				"Код сайта и сами карточки лежат в открытом репозитории: любую правку видно в истории, любую можно предложить.",
		},
		{
			title: "Сохраняйте понравившееся",
			description:
				"Отмечайте проекты сердечком - они собираются на отдельной странице и остаются в браузере без всякой регистрации.",
		},
	],
} = Astro.props;

/*
 * Видео подтягиваются `import.meta.glob`, а не обычным `import`: файл
 * ролика может отсутствовать (его еще не сняли, переименовали, вырезали
 * из репозитория из-за веса), и статический импорт в этом случае роняет
 * всю сборку. Через glob недостающий файл - это просто `undefined`, и
 * карточка показывает заглушку.
 */
const videos = import.meta.glob<{ default: string }>("/src/assets/video/*.mp4", {
	eager: true,
});

const videoSrc = (file: string): string | undefined =>
	videos[`/src/assets/video/${file}`]?.default;

/*
 * Все три записи сняты 1:1 под квадратную карточку, поэтому кадр
 * заполняет ее целиком и ничего не обрезается. Новые ролики тоже нужно
 * снимать квадратными - иначе `object-cover` срежет им края.
 */
const VIDEOS = [videoSrc("p-v-3.mp4"), videoSrc("p-v-2.mp4"), videoSrc("p-v-4.mp4")] as const;
---

<section class="py-16">
	<h2 class="text-center font-black text-3xl text-balance sm:text-4xl">
		{heading}
	</h2>

	<div class="mt-12 grid gap-6 sm:grid-cols-3">
		{
			items.map((item, index) => (
				<div class="flex flex-col items-center text-center">
					<div class="relative aspect-square w-full overflow-hidden rounded-3xl corner-squircle bg-muted">
						{VIDEOS[index] && (
							<video
								data-feature-video
								src={VIDEOS[index]}
								class="h-full w-full object-cover"
								loop
								muted
								playsinline
								autoplay
								preload="metadata"
							/>
						)}
					</div>
					<p class="mt-6 font-semibold text-foreground text-lg">{item.title}</p>
					<p class="mt-2 text-muted-foreground text-sm">{item.description}</p>
				</div>
			))
		}
	</div>
</section>

<script>
	/*
	 * Видео может не доехать - файла нет в сборке, кодек не поддержан, сеть
	 * оборвалась. Пустой черный квадрат в таком случае выглядит поломкой,
	 * поэтому при ошибке загрузки видео уступает место статичной заглушке.
	 *
	 * Слушатель именно на `<video>`, а не на `window`: событие `error` от
	 * медиа не всплывает, до делегирования на документ оно не доходит.
	 */
	for (const video of document.querySelectorAll<HTMLVideoElement>("[data-feature-video]")) {
		video.addEventListener("error", () => {
			video.hidden = true;

			const fallback = video.parentElement?.querySelector<HTMLElement>(
				"[data-feature-fallback]",
			);
			if (fallback) fallback.hidden = false;
		});
	}
</script>
