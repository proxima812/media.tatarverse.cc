---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Item {
	title: string;
	description: string;
}

interface Props {
	heading?: string;
	items?: Item[];
}

/*
 * Контент по умолчанию - не lorem ipsum, реальные сценарии работы с
 * каталогом (см. тот же принцип в FAQ.astro). У каждой карточки своя
 * иллюстрация: поиск (search), исходники на GitHub (open-sourse),
 * сохранение проекта в избранное (save).
 */
const {
	heading = "Все в одном каталоге - это удобно",
	items = [
		{
			title: "Находите за секунды",
			description:
				"Поиск по названию, описанию и тегам сужает каталог по мере ввода - а рядом весь список по алфавиту.",
		},
		{
			title: "Все открыто на GitHub",
			description:
				"Код сайта и сами карточки лежат в открытом репозитории: любую правку видно в истории, любую можно предложить.",
		},
		{
			title: "Сохраняйте понравившееся",
			description:
				"Отмечайте проекты сердечком - они собираются на отдельной странице и остаются в браузере без всякой регистрации.",
		},
	],
} = Astro.props;

/*
 * Кадры подхватываются `import.meta.glob`, а не обычным `import`: файл
 * может отсутствовать (его переименовали, еще не нарисовали, вырезали из
 * репозитория), и статический импорт в этом случае роняет всю сборку.
 * Через glob недостающий файл - это просто `undefined`, и карточка
 * показывает пустую подложку вместо падения.
 */
const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/video/*.png",
	{ eager: true },
);

const imageSrc = (file: string): ImageMetadata | undefined =>
	images[`/src/assets/video/${file}`]?.default;

/*
 * Все три картинки нарисованы 1:1 под квадратную карточку, поэтому кадр
 * заполняет ее целиком и ничего не обрезается. Новые тоже нужно готовить
 * квадратными - иначе `object-cover` срежет им края.
 *
 * Порядок связан с порядком текстов индексом, поэтому переставлять их
 * можно только вместе.
 */
const IMAGES = [
	imageSrc("search.png"),
	imageSrc("open-sourse.png"),
	imageSrc("save.png"),
] as const;

/**
 * Ширина карточки в css-пикселях: колонка контента `max-w-7xl` минус `px-5`
 * с двух сторон, поделенная на три колонки с зазором `gap-6`.
 */
const SIZES = "(min-width: 1280px) 400px, (min-width: 640px) 33vw, calc(100vw - 2.5rem)";
---

<section class="py-16">
	<h2 class="text-center font-black text-3xl text-balance sm:text-4xl">
		{heading}
	</h2>

	<div class="mt-12 grid gap-6 sm:grid-cols-3">
		{
			items.map((item, index) => {
				/* Локальная переменная, а не `IMAGES[index]` прямо в разметке: обращение
				   по индексу не сужает тип, и `src` остался бы `ImageMetadata | undefined`. */
				const image = IMAGES[index];

				return (
				<div class="flex flex-col items-center text-center">
					<div class="relative aspect-square w-full overflow-hidden rounded-3xl corner-squircle bg-muted">
						{image && (
							<Image
								src={image}
								alt=""
								widths={[400, 640, 800]}
								sizes={SIZES}
								format="webp"
								quality={80}
								loading="lazy"
								decoding="async"
								class="h-full w-full object-cover"
							/>
						)}
					</div>
					<p class="mt-6 font-semibold text-foreground text-lg">{item.title}</p>
					<p class="mt-2 text-muted-foreground text-sm">{item.description}</p>
				</div>
				);
			})
		}
	</div>
</section>
