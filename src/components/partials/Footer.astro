---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import BigWordBottom from "@/components/partials/BigWordBottom.astro";
import Tooltip from "@/components/partials/Tooltip.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";
import { cn } from "cn";

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * «Разделы» - полная карта сайта, а не сокращенный набор из шапки: подвал
 * читают именно тогда, когда нужного пункта в шапке не нашлось, и обрезанный
 * список там бесполезен. Правовые страницы живут отдельной строкой внизу.
 */
const sectionLinks = [
	{ href: getRelativeLocaleUrl(locale, "catalog"), label: t("nav.catalog") },
	{ href: getRelativeLocaleUrl(locale, "search"), label: t("nav.search") },
	{ href: getRelativeLocaleUrl(locale, "saved"), label: t("nav.saved") },
];

/*
 * «Полезное» - страницы о самом каталоге, а не его содержимом: их читают
 * один раз и по своей причине, поэтому в списке разделов они только
 * разбавляли бы навигацию по данным.
 */
const usefulLinks = [
	{ href: getRelativeLocaleUrl(locale, "about"), label: t("nav.about") },
	{ href: getRelativeLocaleUrl(locale, "add"), label: t("nav.add") },
];

/*
 * Соцсети и связь - те же аккаунты, что в подвале tatarverse.cc: у проектов
 * одна редакция, и разводить их по разным аккаунтам значит терять читателя
 * на переходе между сайтами. Иконки - один набор `tabler`: у mdi
 * логотипы соцсетей нарисованы заливкой, у tabler - контуром, и вперемешку
 * колонка читается как собранная из двух разных подвалов.
 *
 * Видимая подпись - точный хендл, а не имя площадки: его копируют и ищут
 * по нему. Площадку показывает иконка, а для скринридера она уходит в
 * `aria-label` - иначе он прочитает четыре одинаковых «эт-the_tatarverse».
 */
const socialLinks = [
	{
		href: "https://t.me/the_tatarverse",
		network: "Telegram",
		label: "the_tatarverse",
		icon: "mdi:telegram",
	},
	{
		href: "https://vk.ru/the_tatarverse",
		network: "VK",
		label: "the_tatarverse",
		icon: "mdi:vk",
	},
	{
		href: "https://instagram.com/the_tatarverse",
		network: "Instagram",
		label: "@the_tatarverse",
		icon: "mdi:instagram",
	},
	{
		href: "https://www.threads.com/@the_tatarverse",
		network: "Threads",
		label: "@the_tatarverse",
		icon: "tabler:brand-threads",
	},
];

/*
 * Третья колонка - два коротких блока. «Материал» про сам сайт: исходники
 * открыты, их проверяют и форкают. «Экосистема» - соседние проекты; их
 * держим порознь, иначе «открытый код» читается как еще один сайт рядом.
 */
const materialLinks = [
	{
		href: "https://github.com/proxima812/media.tatarverse.cc",
		network: "GitHub",
		label: t("footer.openSource"),
		icon: "mdi:github",
	},
];

const ecosystemLinks = [
	{
		href: "https://tatarverse.cc",
		network: "tatarverse.cc",
		label: "tatarverse.cc",
		icon: "mdi:world",
	},
];

/** Связь - под «Разделами», отдельным блоком: это одна строка, не колонка. */
const contactLinks = [
	{
		href: "mailto:kamil.mirikhan@gmail.com",
		network: t("footer.email"),
		label: t("footer.email"),
		icon: "tabler:mail",
	},
];

/**
 * Правовые страницы - тут вместо статичной строки «Все права защищены»:
 * текст ничего не дает посетителю, а ссылка на реальный документ дает.
 */
const legalLinks = [
	{ href: getRelativeLocaleUrl(locale, "privacy"), label: t("nav.privacy") },
	{ href: getRelativeLocaleUrl(locale, "terms"), label: t("nav.terms") },
	{ href: getRelativeLocaleUrl(locale, "sources"), label: t("nav.sources") },
];

/** Год - на билде, не в браузере: страница статическая, значение одно для всех. */
const year = new Date().getFullYear();

const linkClass = "text-primary-foreground/70 transition hover:text-primary-foreground";

/** Заголовок колонки: приглушен и разряжен, чтобы не спорить со ссылками. */
const headingClass =
	"mb-4 font-semibold text-primary-foreground/50 text-xs uppercase tracking-wider";
---

<footer
	class="mt-24 no-container overflow-hidden rounded-t-[2rem] bg-primary pt-16 text-base text-primary-foreground sm:rounded-t-[2.5rem] sm:pt-20"
>
	<div class="container mx-auto max-w-6xl px-5 sm:px-8">
		<div
			class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_auto_auto_auto] lg:gap-20"
		>
			<div class="max-w-sm space-y-5">
				<a
					href={getRelativeLocaleUrl(locale, "")}
					class="group relative inline-block"
					aria-label="media.tatarverse"
				>
					<img
						src="/media-tatarverse.svg"
						alt=""
						width="48"
						height="48"
						class="size-12 brightness-0 invert"
					/>
					<Tooltip label={t("nav.home")} />
				</a>
				<p class="text-primary-foreground/60 text-sm">
					{t("meta.description")}
				</p>
			</div>

			<nav aria-label={t("footer.sections")} class="lg:min-w-44">
				<h2 class={headingClass}>{t("footer.sections")}</h2>
				<ul class="space-y-3">
					{
						sectionLinks.map((link) => (
							<li>
								<a href={link.href} class={linkClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>

				<h2 class={cn(headingClass, "mt-8")}>{t("footer.contact")}</h2>
				<ul class="space-y-3">
					{
						contactLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class={cn("flex items-center gap-2", linkClass)}
									aria-label={`${link.network}: ${link.label}`}
								>
									<Icon name={link.icon} class="size-4 shrink-0" aria-hidden="true" />
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-label={t("footer.social")} class="lg:min-w-44">
				<h2 class={headingClass}>{t("footer.social")}</h2>
				<ul class="space-y-3">
					{
						socialLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class={cn("flex items-center gap-2", linkClass)}
									aria-label={`${link.network}: ${link.label}`}
									target={link.href.startsWith("mailto:") ? undefined : "_blank"}
									rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
								>
									<Icon name={link.icon} class="size-4 shrink-0" aria-hidden="true" />
									{link.label}
								</a>
							</li>
						))
					}
				</ul>

				<h2 class={cn(headingClass, "mt-8")}>{t("footer.useful")}</h2>
				<ul class="space-y-3">
					{
						usefulLinks.map((link) => (
							<li>
								<a href={link.href} class={linkClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav aria-label={t("footer.material")} class="lg:min-w-44">
				<h2 class={headingClass}>{t("footer.material")}</h2>
				<ul class="space-y-3">
					{
						materialLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class={cn("flex items-center gap-2", linkClass)}
									target="_blank"
									rel="noopener noreferrer"
								>
									<Icon name={link.icon} class="size-4 shrink-0" aria-hidden="true" />
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
				<h2 class={cn(headingClass, "mt-8")}>{t("footer.ecosystem")}</h2>
				<ul class="space-y-3">
					{
						ecosystemLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class={cn("flex items-center gap-2", linkClass)}
									target="_blank"
									rel="noopener noreferrer"
								>
									<Icon name={link.icon} class="size-4 shrink-0" aria-hidden="true" />
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div
			class="mt-20 flex flex-col gap-2 border-primary-foreground/15 border-t pt-6 pb-12 text-primary-foreground/50 text-sm sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {year} media.tatarverse</p>
			<nav aria-label={t("footer.legal")}>
				<ul class="flex flex-wrap gap-x-6 gap-y-2">
					{
						legalLinks.map((link) => (
							<li>
								<a href={link.href} class={linkClass}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</footer>

<div class="no-container bg-primary">
	<BigWordBottom
		text="Муэллиф"
		color1="from-primary-foreground"
		color2="to-primary-foreground/25"
		fade="after:to-primary"
	/>
</div>
