---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * Кадры подхватываются `import.meta.glob`, а не восемью импортами подряд:
 * добавить девятый снимок должно быть достаточно, положив `9.png` рядом.
 * Порядок задают сами имена файлов, поэтому сортировка числовая - при
 * строковой `10.png` встал бы между `1.png` и `2.png`.
 *
 * Файлы не из нумерованного ряда (если в папке заведется что-то еще)
 * отсеиваются: `Number("present")` дает `NaN`.
 */
const modules = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/main/*.png", {
	eager: true,
});

const slideOrder = (path: string): number =>
	Number(path.split("/").at(-1)?.replace(".png", ""));

const screens = Object.entries(modules)
	.map(([path, module]) => ({ order: slideOrder(path), image: module.default }))
	.filter((slide) => Number.isFinite(slide.order))
	.sort((a, b) => a.order - b.order)
	.map((slide) => slide.image);

/**
 * Ширина колонки контента: `max-w-7xl` (1280px) минус `px-5` с двух сторон.
 * Нужна браузеру, чтобы выбрать вариант из `srcset` до раскладки страницы.
 */
const SIZES = "(min-width: 1280px) 1240px, calc(100vw - 2.5rem)";
---

{
	/*
	Кадры лежат стопкой: первый в потоке - он задает высоту блока, остальные
	поверх него `absolute`. Так контейнеру не нужно прописывать пропорцию
	руками, и она не разъедется, если снимки пересняли в другом размере.

	`role="img"` с подписью на контейнере, а у самих снимков `alt=""`: для
	скринридера это одна иллюстрация, а не восемь безымянных картинок.
*/
}
<div
	data-showcase
	role="img"
	aria-label={t("videoShowcase.label")}
	title={t("videoShowcase.label")}
	class="pointer-events-none relative my-6 w-full select-none overflow-hidden rounded-4xl border border-primary/10"
>
	{
		screens.map((screen, index) => (
			<Image
				data-showcase-slide
				data-slide={index === 0 ? "current" : "idle"}
				src={screen}
				alt=""
				widths={[640, 960, 1240, 1860]}
				sizes={SIZES}
				format="webp"
				quality={72}
				loading={index === 0 ? "eager" : "lazy"}
				decoding={index === 0 ? "sync" : "async"}
				class:list={[
					"h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-in-out",
					"data-[slide=current]:z-10 data-[slide=current]:opacity-100",
					"data-[slide=front]:z-20 data-[slide=front]:opacity-100",
					index === 0 ? "relative" : "absolute inset-0",
				]}
			/>
		))
	}
</div>

<script>
	/*
	 * Показ кадров каталога. Смена идет наложением, а не встречным
	 * растворением: входящий кадр поднимается над текущим (`front`) и
	 * проявляется, и только когда он уже непрозрачен, нижний гасится. При
	 * встречном растворении в середине перехода суммарная непрозрачность
	 * падает ниже единицы и сквозь оба кадра просвечивает фон - на светлых
	 * скриншотах это заметно как вспышка.
	 *
	 * Отсюда же три состояния вместо двух: `front` (входит, над всеми),
	 * `current` (показывается) и `idle` (спрятан). Разводить их одним
	 * булевым атрибутом нельзя - порядок кадров в DOM решал бы спор о том,
	 * кто выше, и переход с последнего кадра на первый не был бы виден.
	 */
	const FADE_MS = 700; // = duration-700 в разметке
	const HOLD_MS = 1400;

	function setupShowcase(root: HTMLElement) {
		const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-showcase-slide]"));
		if (slides.length < 2) return;

		let current = 0;
		let timer = 0;
		let fade = 0;
		let onScreen = false;

		const advance = () => {
			const next = (current + 1) % slides.length;
			const incoming = slides[next];
			const outgoing = slides[current];
			if (!incoming || !outgoing) return;

			incoming.dataset.slide = "front";
			current = next;

			fade = window.setTimeout(() => {
				outgoing.dataset.slide = "idle";
				incoming.dataset.slide = "current";
			}, FADE_MS);
		};

		const start = () => {
			if (timer) return;
			timer = window.setInterval(advance, HOLD_MS);
		};

		const stop = () => {
			window.clearInterval(timer);
			timer = 0;
		};

		/*
		 * Крутить показ, когда блок за экраном или вкладка в фоне, незачем:
		 * это работа впустую, а на ноутбуке - еще и расход батареи. Возврат
		 * на вкладку подхватывает показ с того кадра, на котором он встал.
		 */
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) stop();
			else if (onScreen) start();
		});

		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				onScreen = entry.isIntersecting;

				if (onScreen && !document.hidden) start();
				else stop();
			}
		});

		observer.observe(root);

		window.addEventListener("pagehide", () => {
			stop();
			window.clearTimeout(fade);
			observer.disconnect();
		});
	}

	/*
	 * `prefers-reduced-motion` - не про плавность анимации, а про ее наличие:
	 * при включенной настройке движение на странице человеку мешает или
	 * вызывает недомогание. Показ не запускается вовсе, остается первый кадр.
	 */
	if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		for (const root of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
			setupShowcase(root);
		}
	}
</script>
