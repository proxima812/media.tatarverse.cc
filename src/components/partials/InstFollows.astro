---
import { Icon } from "astro-icon/components";
import { followers } from "@/data/inst_follows";

/**
 * Стена подписчиков: две строки по десять хендлов под заголовком - тот же
 * прием, что у полос с логотипами клиентов. Показывает, что за каталогом
 * стоят живые люди, не превращаясь в список на весь экран.
 */
interface Props {
	title?: string;
}

const { title = "Спасибо Вам за поддержку." } = Astro.props;

/*
 * Состав и порядок живут в данных, а не здесь: список короткий и ручной,
 * его правят целиком - компоненту остается только разложить его надвое.
 * Нечетная длина округляется вверх, иначе лишний хендл выпал бы молча.
 */
const perRow = Math.ceil(followers.length / 2);
const rows = [followers.slice(0, perRow), followers.slice(perRow)];
---

<section class="py-16 sm:py-24">
	<h2
		class="mx-auto max-w-3xl text-balance px-5 text-center font-bold text-3xl tracking-tight sm:text-4xl"
	>
		{title}
	</h2>

	<!--
		Строки не переносятся и уезжают за край: маска гасит их к краям экрана,
		и обрезанный хендл читается как «список продолжается», а не как
		случайно обрубленное имя. Отсюда же `no-container` - в колонке
		`max-w-6xl` край пришелся бы на пустое поле, и гасить было бы нечего.

		`select-none` + `pointer-events-none`: это витрина, а не навигация -
		хендлы не кликаются и не выделяются, курсор проходит сквозь них.
	-->
	<div
		class="no-container mt-10 select-none space-y-6 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]"
	>
		{rows.map((row) => (
			<ul
				class="pointer-events-none flex flex-nowrap justify-center gap-x-8 px-5 sm:gap-x-12"
				aria-hidden="true"
			>
				{row.map((follower) => (
					<li class="flex shrink-0 items-center gap-2 text-muted-foreground">
						<Icon
							name="tabler:brand-instagram"
							class="size-5 shrink-0"
							aria-hidden="true"
						/>
						<span class="font-medium text-sm sm:text-base">{follower.handle}</span>
					</li>
				))}
			</ul>
		))}
	</div>
</section>
