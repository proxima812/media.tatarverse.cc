---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import CardLogo from "@/components/Catalog/CardLogo.astro";
import Button from "@/components/partials/Button.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";
import { sortByPubDate } from "@/lib/catalog/sort";

type Card = CollectionEntry<"cards">;

interface Props {
	locale: LocaleCode;
	cards: Card[];
}

/** Сколько плиток в одной строке ленты. */
const PER_ROW = 7;

/*
 * Три строки, направления чередуются: влево → вправо → влево. Разные
 * длительности у соседних строк обязательны - при одинаковых лента читается
 * как одна плита, ползущая туда-сюда, а не как три независимых потока.
 */
const ROWS = [
	{ direction: "left", duration: 96 },
	{ direction: "right", duration: 108 },
	{ direction: "left", duration: 102 },
] as const;

const { locale, cards } = Astro.props;
const t = useTranslations(locale);

/*
 * Лента показывает последние добавленные проекты - те же, что открывают
 * каталог. Карточка без логотипа не пропускается: `CardLogo` рисует
 * детерминированный градиент со знаком народа, и дырки в ленте не будет.
 */
const latest = sortByPubDate(cards).slice(0, ROWS.length * PER_ROW);

const rows = ROWS.map((row, rowIndex) => ({
	...row,
	items: latest.slice(rowIndex * PER_ROW, (rowIndex + 1) * PER_ROW),
}));
---

<section class="mx-auto max-w-2xl text-center">
	<h2 class="font-black text-4xl text-balance sm:text-5xl">
		{t("marquee.cta.title")}
	</h2>

	<p class="mt-5 text-balance text-lg text-muted-foreground">
		{t("marquee.cta.description")}
	</p>

	<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
		<Button
			href={getRelativeLocaleUrl(locale, "catalog")}
			preset="solid"
			radius="sm"
			size="md"
		>
			<Icon name="mdi:view-grid-outline" class="size-4" aria-hidden="true" />
			{t("marquee.cta.catalog")}
		</Button>
		<Button
			href={getRelativeLocaleUrl(locale, "add")}
			preset="outline"
			radius="sm"
			size="md"
		>
			<Icon name="mdi:plus" class="size-4" aria-hidden="true" />
			{t("marquee.cta.add")}
		</Button>
	</div>
</section>

<!--
	`no-container` вынимает секцию из колонки `Container`: лента должна уезжать
	за край экрана, а не упираться в `max-w-6xl` - обрезанная по ширине колонки,
	она читается как список с многоточием, а не как бесконечный поток.
-->
<section
	aria-label={t("marquee.label")}
	class="no-container overflow-hidden py-6"
>
	<div class="flex flex-col gap-4">
		{rows.map((row) => (
				<div
					class="marquee"
					data-direction={row.direction}
					style={`--marquee-duration:${row.duration}s`}
				>
					<div class="marquee__track">
						{/*
						 * Две одинаковые копии подряд: анимация сдвигает дорожку ровно
						 * на 50% ее ширины, и в момент возврата в начало кадр совпадает
						 * с предыдущим - стык не виден. Копия - `aria-hidden`, чтобы
						 * скринридер не читал каталог дважды.
						 */}
						{[false, true].map((isClone) => (
							<div class="marquee__group" aria-hidden={isClone ? "true" : undefined}>
								{row.items.map((card) => (
									<a
										href={getRelativeLocaleUrl(locale, `projects/${card.id}`)}
										class="flex shrink-0 items-center gap-3 rounded-md corner-squircle px-2 py-1 transition hover:bg-muted/60"
										tabindex={isClone ? -1 : undefined}
									>
										<div class="shrink-0 overflow-hidden rounded-full corner-squircle border border-border bg-background">
											<CardLogo
												name={card.data.name}
												logo={card.data.logo}
												peoples={card.data.peoples}
												size="md"
											/>
										</div>
										<span class="whitespace-nowrap font-semibold text-foreground text-xl tracking-tight">
											{card.data.name}
										</span>
									</a>
								))}
							</div>
						))}
					</div>
				</div>
			))}
	</div>
</section>

<style>
.marquee {
	--marquee-gap: 2.5rem;
	overflow: hidden;
}

.marquee__track {
	display: flex;
	width: max-content;
	animation: marquee var(--marquee-duration) linear infinite;
	will-change: transform;
}

/*
 * Зазор живет внутри группы (`gap` + завершающий `padding`), а между группами
 * его нет. Будь `gap` на самой дорожке, ее половина отличалась бы от ширины
 * одной группы ровно на половину зазора - и на каждом обороте лента дергалась
 * бы на этот остаток.
 */
.marquee__group {
	display: flex;
	align-items: center;
	gap: var(--marquee-gap);
	padding-inline-end: var(--marquee-gap);
}

.marquee[data-direction="right"] .marquee__track {
	animation-direction: reverse;
}

.marquee:hover .marquee__track,
.marquee:focus-within .marquee__track {
	animation-play-state: paused;
}

@keyframes marquee {
	to {
		transform: translateX(-50%);
	}
}

@media (prefers-reduced-motion: reduce) {
	.marquee__track {
		animation: none;
	}

	/* Без движения вторая копия - просто дубликат за краем экрана. */
	.marquee__group[aria-hidden="true"] {
		display: none;
	}
}
</style>
