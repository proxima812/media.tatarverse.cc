---
import { Image } from "astro:assets";

/**
 * Заголовок - снимок - пояснение в одну строку. Смысл раскладки в том, что
 * снимок стоит между двумя текстами и читается как то, о чем они говорят:
 * слева утверждение, справа расшифровка, между ними сам предмет разговора.
 *
 * Снимок не один: кадры сменяют друг друга вместе с подписью под ними.
 */
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Know what you're looking at.",
	description = "Cosmos researches images - surfacing the artist, source, and story.",
} = Astro.props;

/*
 * Кадры подхватываются `import.meta.glob`, а не импортами подряд: добавить
 * снимок должно быть достаточно, положив файл в папку. Порядок - по имени,
 * чтобы состав ленты не зависел от порядка обхода файловой системы.
 */
const modules = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/PhoteStatment/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const photos = Object.entries(modules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, module]) => module.default);

/*
 * Подписи идут своим списком и раздаются кадрам по кругу: снимков может
 * стать больше или меньше, и жесткая пара «файл - подпись» ломалась бы при
 * каждой правке папки.
 */
const CAPTIONS = [
	{ caption: "Editorial photography by", author: "Guiri" },
	{ caption: "Photograph from Unformen der Kunst", author: "Karl Blossfeldt" },
	{ caption: "The OOAA Arquitectura Studio. Designed by", author: "Iker Ochotorena" },
] as const;

const slides = photos.map((photo, index) => ({
	photo,
	...CAPTIONS[index % CAPTIONS.length],
}));

/** Ширина снимка в css-пикселях - от нее считается исходник растра. */
const PHOTO_WIDTH = 420;

/** Сколько один кадр держится на экране, включая перекрестное затухание. */
const SLIDE_SECONDS = 5;
const total = slides.length * SLIDE_SECONDS;

/*
 * Keyframes собираются строкой, а не пишутся руками: доля одного кадра
 * зависит от их числа, и при добавлении файла в папку проценты в статичном
 * CSS пришлось бы пересчитывать вручную - о чем никто не вспомнит.
 *
 * `fade` - доля цикла на перекрестное затухание. Дальше кадр держится
 * непрозрачным до своей границы и уходит в ноль, где его подхватывает следующий.
 */
const share = 100 / Math.max(slides.length, 1);
const fade = Math.min(share / 2, 3);
const keyframes = `@keyframes photo-statement {
	0% { opacity: 0 }
	${fade.toFixed(2)}% { opacity: 1 }
	${(share - fade).toFixed(2)}% { opacity: 1 }
	${share.toFixed(2)}% { opacity: 0 }
	100% { opacity: 0 }
}`;
---

<section>
	<!--
		Раскладка снята с оригинала (cosmos.so): на узком экране колонка -
		текст, снимок, текст, на `lg` строка по центру. `justify-center`, а не
		распорка колонок: тексты жмутся к снимку, иначе между ним и фразой
		повисает случайная дыра.

		Своей ширины и горизонтальных отступов у секции нет - она живет в
		колонке `Container` (`max-w-7xl px-5`), как остальные блоки главной.
	-->
	<div
		class="mx-auto flex w-full flex-col items-center gap-5 py-16 sm:py-24 lg:flex-row lg:justify-center lg:gap-12 xl:gap-[30px]"
	>
		<h2
			class="max-w-[10ch] text-balance text-center font-medium text-[40px] leading-[1.02] tracking-[-0.03em] sm:text-6xl lg:text-right lg:text-[68px]"
		>
			{title}
		</h2>

		<figure
			class="photo-statement relative aspect-[21/32] w-full max-w-[420px] shrink-0"
			style={`--slide-total:${total}s`}
		>
			{slides.map((slide, index) => (
				<div
					class="photo-statement__slide absolute inset-0"
					style={`--slide-delay:${index * SLIDE_SECONDS}s`}
				>
					<Image
						src={slide.photo}
						alt=""
						width={PHOTO_WIDTH}
						height={Math.round((PHOTO_WIDTH * 32) / 21)}
						densities={[1, 2]}
						format="webp"
						loading={index === 0 ? "eager" : "lazy"}
						class="size-full rounded-[14px] object-cover"
					/>

					<!--
						Подпись лежит поверх снимка по центру. `drop-shadow` вместо
						подложки на всю строку: затемнять кадр целиком ради одной
						строки текста - терять сам снимок, а тень читается на любом фоне.
					-->
					<figcaption
						class="absolute inset-x-4 top-1/2 flex -translate-y-1/2 flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center font-medium text-[15px] text-white drop-shadow-[0_1px_8px_rgb(0_0_0/0.45)] sm:text-base"
					>
						{slide.caption}
						<span class="rounded-full bg-white/20 px-3 py-1 backdrop-blur-md">
							{slide.author}
						</span>
					</figcaption>
				</div>
			))}
		</figure>

		<p
			class="max-w-[22ch] text-center text-lg text-muted-foreground leading-[1.25] tracking-[-0.01em] sm:text-xl lg:text-left lg:text-[26px]"
		>
			{description}
		</p>
	</div>
</section>

<style is:inline set:html={keyframes}></style>

<style>
/*
 * Кадры лежат стопкой и по очереди проявляются. Высоту задает сама `figure`
 * (`aspect-[21/32]`), поэтому слайды могут быть `absolute` все до одного -
 * без «первый в потоке, остальные поверх» и вызванного этим скачка раскладки.
 */
.photo-statement__slide {
	opacity: 0;
	animation: photo-statement var(--slide-total) linear infinite;
	animation-delay: var(--slide-delay);
	will-change: opacity;
}

/* Один кадр - анимировать нечего, он и так на экране. */
.photo-statement__slide:only-child {
	opacity: 1;
	animation: none;
}

@media (prefers-reduced-motion: reduce) {
	.photo-statement__slide {
		animation: none;
	}

	/* Без перелистывания показываем первый кадр, остальные не мигают. */
	.photo-statement__slide:first-child {
		opacity: 1;
	}
}
</style>
