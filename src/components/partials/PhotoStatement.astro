---
import { Image } from "astro:assets";

/**
 * Заголовок - снимок - пояснение в одну строку. Смысл раскладки в том, что
 * снимок стоит между двумя текстами и читается как то, о чем они говорят:
 * слева утверждение, справа расшифровка, между ними сам предмет разговора.
 *
 * Снимок не один: кадры сменяют друг друга вместе с подписью под ними.
 */
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Know what you're looking at.",
	description = "Cosmos researches images - surfacing the artist, source, and story.",
} = Astro.props;

/*
 * Кадры подхватываются `import.meta.glob`, а не импортами подряд: добавить
 * снимок должно быть достаточно, положив файл в папку. Порядок - по имени,
 * чтобы состав ленты не зависел от порядка обхода файловой системы.
 */
const modules = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/PhoteStatment/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const photos = Object.entries(modules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, module]) => module.default);

/*
 * Подписи идут своим списком и раздаются кадрам по кругу: снимков может
 * стать больше или меньше, и жесткая пара «файл - подпись» ломалась бы при
 * каждой правке папки.
 */
const CAPTIONS = [
	{ caption: "Editorial photography by", author: "Guiri" },
	{ caption: "Photograph from Unformen der Kunst", author: "Karl Blossfeldt" },
	{ caption: "The OOAA Arquitectura Studio. Designed by", author: "Iker Ochotorena" },
] as const;

const slides = photos.map((photo, index) => ({
	photo,
	...CAPTIONS[index % CAPTIONS.length],
}));

/** Ширина снимка в css-пикселях - от нее считается исходник растра. */
const PHOTO_WIDTH = 420;

/** Сколько один кадр держится на экране, включая перекрестное затухание. */
const SLIDE_SECONDS = 5;
const total = slides.length * SLIDE_SECONDS;

/*
 * Смена кадров устроена как в оригинале (cosmos.so) и это не затухание:
 * новый кадр наезжает шторкой снизу вверх - `clip-path: inset()` открывает
 * его полосой, а картинка и подпись внутри едут навстречу. Так кадр не
 * «просвечивает» сквозь соседний, чего при кроссфейде двух фотографий
 * не избежать.
 *
 * Keyframes собираются строкой, а не пишутся руками: доля одного кадра
 * зависит от их числа, и при добавлении файла в папку проценты в статичном
 * CSS пришлось бы пересчитывать вручную - о чем никто не вспомнит.
 */
const share = 100 / Math.max(slides.length, 1);
/** Доля цикла на саму шторку. Остальное кадр просто стоит. */
const reveal = Math.min(share * 0.35, 12);
/** На сколько содержимое кадра сдвинуто в момент входа и выхода, как в оригинале. */
const SHIFT_PX = 30;

const pct = (value: number) => `${value.toFixed(2)}%`;

const keyframes = `@keyframes photo-statement-reveal {
	0% { z-index: 2; clip-path: inset(100% 0 0 0) }
	${pct(reveal)} { z-index: 2; clip-path: inset(0) }
	${pct(share)} { z-index: 1; clip-path: inset(0) }
	100% { z-index: 0; clip-path: inset(0) }
}

/*
 * Контр-ход содержимого: пока шторка идет вверх, кадр внутри догоняет ее
 * снизу, а уходя - сдвигается вверх и освобождает место следующему. Без
 * этого шторка читается как жалюзи, а не как смена кадра.
 */
@keyframes photo-statement-shift {
	0% { transform: translate3d(0, ${SHIFT_PX}px, 0) }
	${pct(reveal)} { transform: translate3d(0, 0, 0) }
	${pct(share)} { transform: translate3d(0, 0, 0) }
	${pct(share + reveal)} { transform: translate3d(0, -${SHIFT_PX}px, 0) }
	100% { transform: translate3d(0, -${SHIFT_PX}px, 0) }
}`;
---

<section>
	<div
		class="mx-auto flex w-full flex-col items-center gap-5 py-16 sm:py-24 lg:flex-row lg:justify-center lg:gap-12 xl:gap-[30px]"
	>
		<h2
			class="max-w-[10ch] text-balance text-center font-medium text-[40px] leading-[1.02] tracking-[-0.03em] sm:text-6xl lg:text-right lg:text-[68px]"
		>
			{title}
		</h2>

		<!--
			Скругление и обрезка - на самой `figure`: шторка каждого кадра
			ездит внутри нее, и держи ее слайды - на углах вылезали бы
			прямоугольные края в момент перехода.
		-->
		<figure
			class="photo-statement relative aspect-[21/32] w-full max-w-[420px] shrink-0 overflow-hidden rounded-[14px]"
			style={`--slide-total:${total}s`}
		>
			{
				slides.map((slide, index) => (
					<div
						class="photo-statement__slide absolute inset-0"
						style={`--slide-delay:${index * SLIDE_SECONDS}s`}
					>
						<div class="photo-statement__shift size-full">
							<Image
								src={slide.photo}
								alt=""
								width={PHOTO_WIDTH}
								height={Math.round((PHOTO_WIDTH * 32) / 21)}
								densities={[1, 2]}
								format="webp"
								loading={index === 0 ? "eager" : "lazy"}
								class="size-full object-cover"
							/>
						</div>

						{/*
						 * Центрирование и ход подписи разнесены по двум узлам:
						 * `-translate-y-1/2` и анимация - оба `transform`, и на
						 * одном элементе анимация просто затерла бы центрирование.
						 */}
						<figcaption class="absolute inset-x-0 top-1/2 flex -translate-y-1/2 items-center justify-center">
							<div class="photo-statement__shift flex flex-wrap items-center justify-center gap-1 px-6 text-[18px] text-white">
								<p class="whitespace-nowrap leading-[16px] tracking-[-0.18px]">
									{slide.caption}
								</p>
								<p class="rounded-[11px] bg-white/25 px-[11px] py-[9px] leading-[16px] tracking-[-0.18px] backdrop-blur-[10px]">
									{slide.author}
								</p>
							</div>
						</figcaption>
					</div>
				))
			}
		</figure>

		<p
			class="max-w-[22ch] text-center text-lg text-muted-foreground leading-[1.25] tracking-[-0.01em] sm:text-xl lg:text-left lg:text-[26px]"
		>
			{description}
		</p>
	</div>
</section>

<style is:inline set:html={keyframes}></style>

<style>
	/*
	 * Кадры лежат стопкой. Высоту задает сама `figure` (`aspect-[21/32]`),
	 * поэтому слайды могут быть `absolute` все до одного - без «первый в
	 * потоке, остальные поверх» и вызванного этим скачка раскладки.
	 *
	 * `backwards` обязателен: до своей очереди слайд обязан стоять закрытым
	 * (кадр `0%`), иначе во время `animation-delay` все три висят раскрытыми
	 * друг на друге и до первой смены виден только последний.
	 */
	.photo-statement__slide {
		animation: photo-statement-reveal var(--slide-total) ease-in-out infinite
			backwards;
		animation-delay: var(--slide-delay);
		will-change: clip-path;
	}

	/* Картинка и подпись едут одинаково, каждая своим узлом. */
	.photo-statement__shift {
		animation: photo-statement-shift var(--slide-total) ease-in-out infinite
			backwards;
		animation-delay: var(--slide-delay);
		will-change: transform;
	}

	/* Один кадр - двигать нечего, он и так на экране. */
	.photo-statement__slide:only-child,
	.photo-statement__slide:only-child .photo-statement__shift {
		animation: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.photo-statement__slide,
		.photo-statement__shift {
			animation: none;
		}

		/* Без перелистывания виден первый кадр, остальные лежат под ним. */
		.photo-statement__slide:not(:first-child) {
			clip-path: inset(100% 0 0 0);
		}
	}
</style>
