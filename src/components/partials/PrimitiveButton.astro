---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/utils/lib/cn";

/**
 * Полиморфная кнопка — `<a>`, если передан `href`, иначе `<button>` — по
 * образцу `PrimitiveButton` из proxima-primitive, но с пресетами на
 * семантических токенах проекта (`bg-primary`/`bg-muted`/...), а не на
 * сырых цветах Tailwind, и формой `rounded-full`, как у уже существующих
 * кнопок сайта (CTA на карточках, кнопки в шапке), а не `rounded-xl`
 * оригинала — «взять компонент и применить стили проекта».
 */

type Preset = "solid" | "soft" | "outline" | "ghost";
type Size = "sm" | "md" | "lg" | "icon";

const presets: Record<Preset, string> = {
	solid: "bg-primary text-primary-foreground hover:opacity-90",
	soft: "bg-muted text-muted-foreground hover:bg-muted/70 hover:text-foreground",
	outline: "border border-border bg-background text-foreground hover:bg-muted",
	ghost: "text-muted-foreground hover:bg-muted hover:text-foreground",
};

const sizes: Record<Size, string> = {
	sm: "h-8 gap-1.5 px-3 text-xs",
	md: "h-10 gap-2 px-5 text-sm",
	lg: "h-12 gap-2.5 px-6 text-base",
	icon: "size-9 p-0",
};

interface Props {
	href?: string;
	preset?: Preset;
	size?: Size;
	type?: "button" | "submit" | "reset";
	target?: string;
	rel?: string;
	/** `target="_blank"` + `rel="noreferrer noopener"`, если не заданы явно. */
	external?: boolean;
	class?: string;
}

/*
 * Явные пропсы описывают стилевой контракт; остальное (aria-*, data-*,
 * title) уходит в `rest` без отдельного поля на каждый атрибут — так кнопки
 * вида «иконка + `data-view-button`» остаются возможны без раздувания Props.
 */
const {
	href,
	preset = "solid",
	size = "md",
	type = "button",
	target,
	rel,
	external = false,
	class: className,
	...rest
} = Astro.props as Props & HTMLAttributes<"a"> & HTMLAttributes<"button">;

const linkTarget = target ?? (external ? "_blank" : undefined);
const linkRel = rel ?? (external ? "noreferrer noopener" : undefined);

const classes = cn(
	"inline-flex shrink-0 items-center justify-center rounded-full font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50",
	presets[preset],
	sizes[size],
	className,
);
---

{href ? (
		<a href={href} target={linkTarget} rel={linkRel} class={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type={type} class={classes} {...rest}>
			<slot />
		</button>
	)}
