---
import { Image } from "astro:assets";
import { meshGradient } from "@/utils/lib/meshGradient";

interface Props {
	quote?: string;
	name?: string;
	/**
	 * Фото автора цитаты - импортированный ассет, а не путь строкой:
	 * так `astro:assets` сам сделает webp и версии под плотность экрана.
	 * Нет фото - рисуется мэш-градиент по имени, как у карточек без логотипа.
	 */
	photo?: ImageMetadata;
	/**
	 * Должность автора цитаты. Именно `position`, а не `role`: последнее
	 * коллидирует с ARIA-атрибутом `role`, и линтер по доступности читает
	 * `role="Ведущий разработчик"` как невалидное значение ARIA-роли на теге.
	 */
	position?: string;
}

/*
 * Заглушка по умолчанию: lorem ipsum, имя и должность-плейсхолдер - реальную
 * цитату сюда никто не подставлял, чтобы на сайте не оказался вымышленный
 * отзыв за подписью настоящего (или похожего на настоящего) человека.
 * Компонент готов к использованию - содержимое передается пропами, когда
 * появится настоящая цитата.
 */
const {
	photo,
	quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua, ut enim ad minim veniam.",
	name = "Имя Фамилия",
	position = "Должность, компания",
} = Astro.props;
---

<figure class="mx-auto max-w-4xl px-5 py-16 text-center">
	<blockquote>
		<p
			class="text-balance font-extrabold text-3xl leading-tight sm:text-4xl lg:text-5xl"
		>
			“{quote}”
		</p>
	</blockquote>

	<figcaption class="mt-10 flex flex-col items-center gap-4">
		<div class="relative">
			{photo ? (
				<Image
					src={photo}
					alt=""
					width={64}
					height={64}
					densities={[1, 2]}
					format="webp"
					class="size-16 rounded-full corner-squircle object-cover"
				/>
			) : (
				/* Фоллбэк без фото - тот же прием, что у карточек без логотипа. */
				<div
					class="size-16 rounded-full corner-squircle"
					style={meshGradient(name)}
					aria-hidden="true"
				/>
			)}

			<div
				class="-right-1 -bottom-1 absolute flex size-7 items-center justify-center rounded-xl corner-squircle bg-primary ring-4 ring-background"
				aria-hidden="true"
			>
				<img
					src="/media-tatarverse.svg"
					alt=""
					width="16"
					height="16"
					class="size-4 brightness-0 invert"
				>
			</div>
		</div>

		<div>
			<p class="font-semibold text-foreground">{name}</p>
			<p class="text-muted-foreground text-sm">{position}</p>
		</div>
	</figcaption>
</figure>
