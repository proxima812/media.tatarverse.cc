---
type Frame = {
	alt: string;
	image: string;
	/** Положение и размер внутри панели, в процентах от ее габарита. */
	left: number;
	top: number;
	width: number;
	height: number;
};

type Slide = {
	query: string;
	background: string;
	frames: [Frame, Frame, Frame];
};

interface Props {
	/** Сколько один слайд держится на экране, мс. */
	duration?: number;
	class?: string;
}

const { duration = 2500, class: className = "" } = Astro.props;

const photo = (id: string) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=1200&q=80`;

const slides: Slide[] = [
	{
