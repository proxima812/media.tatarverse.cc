---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { cn } from "cn";
import type { LocaleCode } from "@/config/types";
import { defaultLocale, usePlural } from "@/i18n";

interface Props {
	locale: LocaleCode;
	cards: CollectionEntry<"cards">[];
	heading?: string;
	class?: string;
}

const { locale, cards, heading, class: className = "" } = Astro.props;

const plural = usePlural(locale);
const number = new Intl.NumberFormat(locale);

/*
 * Цифры во втором пункте считаются из коллекции, а не вписаны в текст:
 * карточки приезжают пулл-реквестами, и «324 проекта» в манифесте устарело
 * бы в первый же день (тот же принцип, что в `StatField.astro`).
 */
const counted = (key: string, value: number) =>
	`${number.format(value)} ${plural(key, value)}`;

const totals = [
	counted("stats.projects", cards.length),
	counted("stats.categories", new Set(cards.flatMap((card) => card.data.categories)).size),
	counted("stats.peoples", new Set(cards.flatMap((card) => card.data.peoples)).size),
].join(", ");

/*
 * Четыре утверждения по одному на экран: карточки липкие и наезжают друг на
 * друга по скроллу, поэтому в кадре всегда ровно одна мысль. Отсюда и длина
 * текста - два-три предложения, больше не читается за проход.
 *
 * Иконки - оформление, они одни на все локали; переводится только текст.
 * Фон карточек обязан быть непрозрачным: карточки наезжают друг на друга, и
 * сквозь полупрозрачную просвечивала бы предыдущая.
 */
/*
 * Кастомная палитра из UI-кита (`/docs/ui-kit`, `paletteColors`): пара
 * «пастельная поверхность + темный текст на ней». Карточки наезжают друг на
 * друга, и раньше ступеньку давало смешение серых токенов - теперь каждая
 * карточка своего цвета, так край прилипшей читается однозначно.
 *
 * Цвета взяты парами и хардкодятся здесь намеренно: это не семантика
 * проекта, а конкретные оттенки кита, и вне этой стопки они не переиспользуются.
 */
const PALETTE = [
	{ name: "amber", bg: "#FFECD4", fg: "#8A5A07" },
	{ name: "mint", bg: "#D2FBF0", fg: "#007563" },
	{ name: "cherry", bg: "#FFE8EE", fg: "#9D335F" },
	{ name: "grape", bg: "#EEEDFF", fg: "#5F4CB7" },
] as const;

const ICONS = [
	"mdi:map-marker-question-outline",
	"mdi:view-grid-outline",
	"mdi:source-branch",
	"mdi:account-multiple-plus-outline",
];

interface Statement {
	/** Заголовок утверждения. Номер сюда не входит: его дает счетчик в разметке. */
	title: string;
	text: string;
}

interface Copy {
	heading: string;
	cta: string;
	/** Второе утверждение подставляет посчитанные цифры каталога. */
	statements: (totals: string) => [Statement, Statement, Statement, Statement];
}

const COPY = {
	ru: {
		heading: "Зачем этот каталог",
		cta: "Как добавить проект",
		statements: (totals: string) => [
			{
				title: "Как есть сейчас",
				text: "Проекты о татарском, башкирском и крымскотатарском разбросаны по десяткам каналов, магазинов приложений и личных страниц. Найти их можно, только если уже знаешь, что ищешь.",
			},
			{
				title: "Что делает каталог",
				text: `Собирает их в одном месте: ${totals} - у каждого проекта описание, несколько фактов и ссылка на первоисточник.`,
			},
			{
				title: "Ничего не спрятано",
				text: "Сайт и сами карточки лежат в открытом репозитории. Любую правку видно в истории, любую можно оспорить - и никакой рекламы или платного доступа.",
			},
			{
				title: "Кто его пополняет",
				text: "Любой желающий. Знаете проект, которого здесь нет, - заполните форму на странице «Добавить проект». Удобнее работать с кодом - пришлите pull request.",
			},
		],
	},
	en: {
		heading: "Why this catalog exists",
		cta: "How to add a project",
		statements: (totals: string) => [
			{
				title: "How it stands today",
				text: "Projects about Tatar, Bashkir and Crimean Tatar are scattered across dozens of channels, app stores and personal pages. You can only find them if you already know what you are looking for.",
			},
			{
				title: "What the catalog does",
				text: `It brings them together in one place: ${totals} - each with a description, a few facts and a link to the original source.`,
			},
			{
				title: "Nothing is hidden",
				text: "The site and the cards themselves live in an open repository. Every change is visible in the history and open to challenge - and there are no ads and no paywall.",
			},
			{
				title: "Who keeps it growing",
				text: 'Anyone. Know a project that is missing - fill in the form on the "Add a project" page. If you prefer working with code, send a pull request.',
			},
		],
	},
} satisfies Record<string, Copy>;

const known: Record<string, Copy | undefined> = COPY;
const copy: Copy = known[locale] ?? known[defaultLocale] ?? COPY.ru;

const addHref = getRelativeLocaleUrl(locale, "add");

const total = copy.statements(totals).length;
const pad = (value: number) => String(value).padStart(2, "0");

const statements = copy.statements(totals).map((statement, index) => ({
	...statement,
	icon: ICONS[index] ?? ICONS[0],
	color: PALETTE[index % PALETTE.length],
	/** Позиция в стопке: «02/04». Порядок здесь значим - это шаги рассказа. */
	position: `${pad(index + 1)}/${pad(total)}`,
	...(index === ICONS.length - 1 && { cta: { href: addHref, label: copy.cta } }),
}));
---

<section class={cn("mx-auto w-full max-w-3xl px-4 py-16 sm:px-8", className)}>
	<h2 class="text-center font-black text-3xl text-balance tracking-tight sm:text-4xl">
		{heading ?? copy.heading}
	</h2>

	{
		/*
		 * Прилипание чисто на CSS: у каждой карточки `position: sticky` с общим
		 * `top`, поэтому следующая наезжает на предыдущую по мере прокрутки.
		 * Скрипта и наблюдателя здесь нет вовсе.
		 *
		 * `top` считается от высоты шапки, а не задан числом: иначе первая
		 * прилипшая карточка уезжала бы под нее.
		 */
	}
	<ol class="mt-14 flex flex-col gap-5">
		{
			statements.map((item, index) => (
				<li
					class="palette-card sticky grid min-h-[21rem] content-center gap-4 rounded-3xl corner-squircle p-10 sm:p-12"
					style={`--card-bg:${item.color.bg};--card-fg:${item.color.fg};--i:${index};--behind:${total - 1 - index}`}
				>
					{
						/*
						 * Шапка карточки: знак, заголовок и позиция в стопке. Подпись
						 * («Как есть сейчас») - это и есть заголовок утверждения, поэтому
						 * она набрана заголовком, а не надстрочной рубрикой над текстом.
						 * Номер из исходной подписи не повторяется словом: его несет
						 * счетчик справа.
						 */
					}
					<div class="flex items-center gap-3 border-b border-[color-mix(in_oklab,var(--card-fg),transparent_75%)] pb-4">
						<span class="inline-flex text-[color-mix(in_oklab,var(--card-fg),transparent_20%)]">
							<Icon name={item.icon} class="size-5" aria-hidden="true" />
						</span>

						<h3 class="font-semibold text-2xl leading-tight tracking-tight">
							{item.title}
						</h3>

						<span class="ml-auto font-semibold text-[color-mix(in_oklab,var(--card-fg),transparent_35%)] text-xs tabular-nums">
							{item.position}
						</span>
					</div>

					<p class="text-[color-mix(in_oklab,var(--card-fg),transparent_12%)] text-lg leading-relaxed tracking-tight text-pretty">
						{item.text}
					</p>

					{item.cta && (
						<a
							href={item.cta.href}
							class="w-fit rounded-full bg-[var(--card-fg)] px-5 py-2.5 font-semibold text-[var(--card-bg)] text-sm transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--card-fg)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--card-bg)]"
						>
							{item.cta.label}
						</a>
					)}
				</li>
			))
		}
	</ol>
</section>

<style>
	section {
		/* Шапка перекрывает прилипшую карточку, если не отступить на ее высоту. */
		--sticky-top: 6rem;
		/* Насколько ниже прилипает каждая следующая карточка - кромка колоды. */
		--stack-step: 0.85rem;
	}

	/*
	 * Пара «поверхность + текст» приходит в `--card-bg` / `--card-fg` из
	 * разметки (кастомная палитра UI-кита). Все остальное в карточке -
	 * иконка, счетчик, текст, кнопка - считается смешением `--card-fg` с
	 * прозрачностью, поэтому смена пары перекрашивает карточку целиком.
	 *
	 * Фон обязан быть непрозрачным: сквозь полупрозрачный просвечивала бы
	 * предыдущая карточка стопки. Рамки нет - край прилипшей карточки
	 * читается по смене цвета.
	 */
	.palette-card {
		background-color: var(--card-bg);
		color: var(--card-fg);
	}

	/*
	 * Эффект стопки: у каждой следующей карточки `top` на ступеньку ниже, а
	 * сама она на столько же меньше - поэтому у прилипших видно верхние
	 * кромки, и пачка читается колодой, а не одной карточкой.
	 *
	 * Ступенька считается из `--i` (номер карточки) и `--behind` (сколько
	 * карточек за ней): считать в CSS дешевле, чем плодить классы под каждый
	 * номер, и порядок задан одним местом - разметкой.
	 *
	 * Сдвиг делается `top`, а не `transform`: `transform` у прилипшего
	 * элемента ломает саму привязку - карточка едет вместе со страницей.
	 */
	.palette-card {
		top: calc(var(--sticky-top) + var(--i, 0) * var(--stack-step));
		scale: calc(1 - var(--behind, 0) * 0.012);
		transform-origin: 50% 0;
	}

	/*
	 * Прилипание - это движение, привязанное к прокрутке, а не автоплей:
	 * при `reduce` карточки просто идут списком, ничего не наезжает и
	 * колода не собирается.
	 */
	@media (prefers-reduced-motion: reduce) {
		.palette-card {
			position: static;
			scale: 1;
		}
	}
</style>
