---
import { cn } from "cn";
import Kbd from "@/components/ui/Kbd.astro";
import StrokeIcon from "@/components/ui/StrokeIcon.astro";
import type { LocaleCode } from "@/config/types";
import { useTranslations } from "@/i18n";

interface Props {
	locale: LocaleCode;
	class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<!-- Та же пилюля, что `SearchField` в размере `lg`, но со своей кнопкой
     очистки: указатель прячет ее, пока поле пустое, а подсказка `⌘K`
     уходит, как только кнопка появилась, - справа одно действие, а не два. -->
<search class={cn("w-full", className)}>
	<label
		class="group flex h-14 items-center gap-3 rounded-full bg-background pr-3 pl-5 text-faint ring-1 ring-border-strong ring-inset transition-shadow duration-150 focus-within:shadow-[0_0_0_4px_color-mix(in_oklab,var(--color-tone-blue)_18%,transparent)] focus-within:ring-foreground"
	>
		<span class="sr-only">{t("catalog.search.placeholder")}</span>
		<StrokeIcon name="magnify" size={20} class="shrink-0" />
		<input
			id="catalog-search"
			data-glossary-search
			type="search"
			autocomplete="off"
			spellcheck="false"
			placeholder={t("catalog.search.placeholder")}
			class="peer min-w-0 flex-1 bg-transparent text-base text-foreground placeholder:text-faint focus-visible:outline-none [&::-webkit-search-cancel-button]:hidden"
		/>

		<!-- Нативная кнопка очистки отключена: используем одинаковую во всех браузерах. -->
		<button
			type="button"
			data-glossary-search-clear
			hidden
			aria-label={t("search.clear")}
			class="peer/clear flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full text-muted-foreground transition duration-150 ease-snappy hover:bg-muted hover:text-foreground active:scale-[0.96] motion-reduce:active:scale-100"
		>
			<StrokeIcon name="close" size={16} />
		</button>
		<Kbd class="max-sm:hidden peer-[:not([hidden])]/clear:hidden">⌘K</Kbd>
	</label>
</search>

<script>
/* event.code сохраняет Cmd/Ctrl+K в русской раскладке; preventDefault блокирует поиск браузера. */
const field = document.querySelector<HTMLInputElement>(
	"[data-glossary-search]",
);

if (field) {
	document.addEventListener("keydown", (event) => {
		if (event.code === "KeyK" && (event.metaKey || event.ctrlKey)) {
			event.preventDefault();
			/* `preventScroll`: страницу к полю не тянем - его могли вызвать из середины каталога. */
			field.focus({ preventScroll: true });
			/* Набранное выделяется целиком: следующий символ начинает новый запрос, а не дописывает старый. */
			field.select();
			return;
		}

		if (event.key === "Escape" && document.activeElement === field) {
			field.blur();
		}
	});
}
</script>
