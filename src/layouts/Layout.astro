---
import { Font } from "astro:assets";
import type { Props as ContainerProps } from "@/components/partials/Container.astro";
import Container from "@/components/partials/Container.astro";
import GoogleTagManager from "@/components/SEO/Analytics/GoogleTagManager.astro";
import YandexMetrika from "@/components/SEO/Analytics/YandexMetrika.astro";
import SEO from "@/components/SEO/SEO.astro";
import type { SeoKeywords, SeoPageType } from "@/config/types";
import "@/styles/tailwind.css";
// import { ClientRouter } from "astro:transitions";
import { config } from "main.config";
import Footer from "@/components/partials/Footer.astro";
import Header from "@/components/partials/Header.astro";
import { buildAlternates, isLocale } from "@/i18n";
import { ogLocale } from "@/lib/routes/pageLocale";

interface Props {
	title?: string;
	description?: string;
	datePublished?: string | Date;
	dateModified?: string | Date;
	indexRobots?: boolean;
	type?: SeoPageType;
	keywords?: SeoKeywords;
	ogImage?: string;
	canonicalURL?: string | URL;
	/** og:locale; по умолчанию выводится из локали маршрута. */
	locale?: string;
	name?: string;
	author?: string;
	/** `lang` для `<html>`; по умолчанию - локаль маршрута. */
	htmlLang?: string;
	markdownURL?: string | URL;
	/**
	 * hreflang-альтернативы. По умолчанию строятся из пути страницы;
	 * `false` отключает их совсем (например, для 404).
	 */
	alternates?: Array<{ hreflang: string; href: string | URL }> | false;
	/** Классы для контейнера содержимого. */
	class?: string;
	gap?: string;
	containerOff?: boolean;
	innerSetOff?: boolean;
}

const {
	datePublished,
	dateModified,
	indexRobots,
	title = config.site.og.title,
	type,
	description = config.site.og.description,
	ogImage,
	keywords,
	canonicalURL,
	locale,
	name,
	author,
	htmlLang,
	markdownURL,
	alternates,
	class: className,
	containerOff,
	innerSetOff,
	gap,
} = Astro.props;

/*
 * Локаль шапки и подвала берется из URL, а не из пропса: страницы под `/en/`
 * должны получать `en` сами, иначе каждую пришлось бы помнить передать локаль
 * руками - и один забытый проп дал бы русское меню на английской странице.
 * По той же причине og:locale и hreflang-альтернативы вычисляются здесь,
 * а пропы `locale`/`htmlLang`/`alternates` остались только как override.
 */
const rawLocale = Astro.currentLocale;
const currentLocale = isLocale(rawLocale)
	? rawLocale
	: config.i18n.defaultLocale;

const resolvedAlternates =
	alternates === false
		? undefined
		: (alternates ?? buildAlternates(Astro.url.pathname));

const seoProps = {
	title,
	description,
	...(indexRobots !== undefined && { indexRobots }),
	...(ogImage && { ogImage }),
	...(type && { type }),
	...(keywords && { keywords }),
	...(datePublished && { datePublished }),
	...(dateModified && { dateModified }),
	...(canonicalURL && { canonicalURL }),
	locale: locale ?? ogLocale(currentLocale),
	...(name && { name }),
	...(author && { author }),
	...(markdownURL && { markdownURL }),
	...(resolvedAlternates && { alternates: resolvedAlternates }),
};

const containerAttrs = {
	...(className && { class: className }),
	...(containerOff !== undefined && { containerOff }),
	...(innerSetOff !== undefined && { innerSetOff }),
	...(gap && { gap }),
} satisfies ContainerProps;
---

<html lang={htmlLang ?? currentLocale} class="scroll-smooth subpixel-antialiased">
	<head>
		<Font cssVariable="--font-inter" preload />
		{
			config.site.analytics.googleTagManager.enabled && (
				<GoogleTagManager gtmId={config.site.analytics.googleTagManager.id} />
			)
		}

		{
			config.site.analytics.yandexMetrika.enabled && (
				<YandexMetrika counterId={config.site.analytics.yandexMetrika.id} />
			)
		}
		<SEO {...seoProps} />
		<!-- <ClientRouter /> -->
	</head>
	<body>
		<Header locale={currentLocale} />
		<Container {...containerAttrs}>
			<slot />
		</Container>
		<Footer locale={currentLocale} />
	</body>
</html>
