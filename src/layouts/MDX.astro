---
import Footer from "@/components/partials/Footer.astro";
import Header from "@/components/partials/Header.astro";
import type { LocaleCode } from "@/config/types";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

interface Props {
	locale: LocaleCode;
	title: string;
	description: string;
	/** Дата последнего пересмотра текста — из фронтматтера коллекции `legal`. */
	updatedDate: Date;
}

const { locale, title, description, updatedDate } = Astro.props;
const t = useTranslations(locale);

const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: "long" });
---

<Layout
	title={title}
	description={description}
	htmlLang={locale}
	alternates={buildAlternates(Astro.url.pathname)}
>
	<Header locale={locale} />

	<article class="mx-auto max-w-[640px]">
		<h1 class="font-bold text-3xl text-balance sm:text-4xl">
			{title}
		</h1>
		<p class="mt-2 text-muted-foreground text-sm">
			{t("legal.updated")}{" "}
			<time datetime={updatedDate.toISOString()}>
				{dateFormat.format(updatedDate)}
			</time>
		</p>

		<div
			class="prose prose-neutral mt-8 max-w-none prose-headings:text-balance prose-p:text-pretty"
		>
			<slot />
		</div>
	</article>

	<Footer locale={locale} />
</Layout>
