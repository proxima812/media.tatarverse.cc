---
import CategoryPage from "@/components/pages/CategoryPage.astro";
import { categoryPaths } from "@/lib/routes/paths";

export const getStaticPaths = () => categoryPaths("ru");

const { category, cards, categories } = Astro.props;
---

<CategoryPage
	locale="ru"
	category={category}
	cards={cards}
	categories={categories}
/>
