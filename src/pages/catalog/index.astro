---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Catalog from "@/components/Catalog/Catalog.astro";
import { getAllTags } from "@/components/Catalog/tags";
import Footer from "@/components/partials/Footer.astro";
import Header from "@/components/partials/Header.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("ru");
const cards = await getCollection("cards");
const tags = getAllTags(cards);
---

<Layout
	title={t("nav.catalog")}
	htmlLang="ru"
	alternates={buildAlternates(Astro.url.pathname)}
>
	<Header locale="ru" />
	<div class="px-6 flex justify-between items-center">
		<h1
			class="font-bold chroma-reveal text-primary text-3xl text-balance sm:text-4xl"
		>
			{t("nav.catalog")}
		</h1>
		<div class="text-muted-foreground flex items-center space-x-2 font-medium">
			<Icon
				name="mdi:card-multiple-outline"
				class="size-4.5"
				aria-hidden="true"
			/>
			<span>{cards.length}</span>
		</div>
	</div>
	<Catalog locale="ru" cards={cards} tags={tags} />
	<Footer locale="ru" />
</Layout>
