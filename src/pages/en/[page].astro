---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { mdxPagePaths } from "@/components/pages/paths";
import MDX from "@/layouts/MDX.astro";

/*
 * Один маршрут на все текстовые страницы каталога - «О проекте», «Добавить
 * проект», политика, условия, источники. Статические маршруты (`/catalog`,
 * `/search`, `/saved`) приоритетнее динамического, так что перехватить их
 * этот файл не может; см. `starter-mdx`.
 */
export const getStaticPaths = (() => mdxPagePaths("pagesEn")) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MDX locale="en" {...entry.data}>
	<Content />
</MDX>
