---
import { getEntry, render } from "astro:content";
import MDX from "@/layouts/MDX.astro";

const entry = await getEntry("pagesEn", "add");
if (!entry) throw new Error("pagesEn/add отсутствует в коллекции");

const { Content } = await render(entry);
---

<MDX locale="en" {...entry.data}>
	<Content />
</MDX>
