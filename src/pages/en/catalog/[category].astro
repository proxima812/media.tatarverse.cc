---
import CategoryPage from "@/components/pages/CategoryPage.astro";
import { categoryPaths } from "@/components/pages/paths";

export const getStaticPaths = () => categoryPaths("en");

const { category, cards, categories } = Astro.props;
---

<CategoryPage
	locale="en"
	category={category}
	cards={cards}
	categories={categories}
/>
