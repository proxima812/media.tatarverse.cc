---
import { getCollection } from "astro:content";
import { localizeCards } from "@/components/Catalog/localize";
import CatalogStats from "@/components/CatalogStats/CatalogStats.astro";
import MainTitle from "@/components/MainTitle.astro";
import FAQ from "@/components/partials/FAQ.astro";
import Features from "@/components/partials/Features.astro";
import LogoMarquee from "@/components/partials/LogoMarquee.astro";
import LogoStack from "@/components/partials/LogoStack.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("en");
const cards = await localizeCards(await getCollection("cards"), "en");

/** У `FAQ` дефолты только на русском - на английской версии передаем свои. */
const faqItems = [
	{
		question: "What is media.tatarverse?",
		answer:
			"An open catalog of projects about the Tatar, Bashkir, and Crimean Tatar languages and cultures: language apps, channels, media outlets, courses, and graphic design work in one place.",
	},
	{
		question: "How do I add my project to the catalog?",
		answer:
			"Via a pull request in the open GitHub repository - fill in a card following the existing examples and submit it for review.",
	},
	{
		question: "Is it free?",
		answer:
			"Yes. The catalog shows no ads and doesn't sell access - the source code is open, with no commercial model.",
	},
	{
		question: "Who owns the logos in the cards?",
		answer:
			'The respective project owners - we use them only for identification. See the "Sources" page for details.',
	},
	{
		question: "Found an error in a card - where do I report it?",
		answer:
			"Open an issue in the GitHub repository - we try to respond quickly.",
	},
];

/** У `Features` дефолты только на русском - на английской версии передаем свои. */
const featuresItems = [
	{
		title: "Find it in seconds",
		description:
			"Search by name, description, and tags narrows the catalog as you type - with the full A-Z list right next to it.",
	},
	{
		title: "Open source on GitHub",
		description:
			"The site and the cards themselves live in a public repository: every change is in the history, and anyone can propose one.",
	},
	{
		title: "Keep what you like",
		description:
			"Heart a project and it lands on your saved page - stored in the browser, no account needed.",
	},
];
---

<Layout
	title={t("meta.title")}
	description={t("meta.description")}
	htmlLang="en"
	locale="en-US"
	alternates={buildAlternates(Astro.url.pathname)}
	markdownURL="/en.md"
>
	<LogoStack />

	<MainTitle locale="en" />

	<LogoMarquee locale="en" cards={cards} />

	<Features
		heading="One catalog - three ways to use it."
		items={featuresItems}
	/>

	<CatalogStats locale="en" cards={cards} />

	<FAQ title="Frequently asked questions" items={faqItems} />

</Layout>
