---
import { getRelativeLocaleUrl } from "astro:i18n";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("en");
---

<Layout
	title={t("meta.title")}
	description={t("meta.description")}
	htmlLang="en"
	locale="en-US"
	alternates={buildAlternates(Astro.url.pathname)}
	markdownURL="/en.md"
>
	<h1 class="text-4xl font-bold text-balance">{t("home.heading")}</h1>

	<p class="text-muted-foreground">
		{t("home.leadBefore")}
		<code class="rounded bg-muted px-1.5 py-0.5 text-foreground"
			>main.config.ts</code
		>{t("home.leadAfter")}
	</p>

	<p>
		<a
			class="underline underline-offset-4"
			href={getRelativeLocaleUrl("ru", "")}
		>
			{t("home.switcher")}
		</a>
	</p>
</Layout>
