---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import CatalogCard from "@/components/Catalog/CatalogCard.astro";
import { localizeCards } from "@/components/Catalog/localize";
import Button from "@/components/partials/Button.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("en");
const cards = await localizeCards(await getCollection("cards"), "en");
---

<Layout
	title={t("saved.title")}
	htmlLang="en"
	locale="en-US"
	alternates={buildAlternates(Astro.url.pathname)}
>

	<div class="flex items-center justify-between px-6">
		<h1 class="font-bold text-3xl text-balance sm:text-4xl">
			{t("saved.title")}
		</h1>
		<div class="flex items-center space-x-2 font-medium text-muted-foreground">
			<Icon
				name="mdi:bookmark-multiple-outline"
				class="size-5"
				aria-hidden="true"
			/>
			<span data-saved-count>0</span>
		</div>
	</div>

	<div
		data-saved-empty
		class="mx-auto flex max-w-md flex-col items-center gap-4 px-5 py-24 text-center"
	>
		<Icon
			name="mdi:bookmark-outline"
			class="size-10 text-muted-foreground"
			aria-hidden="true"
		/>
		<h2 class="font-semibold text-lg">{t("saved.empty.title")}</h2>
		<p class="text-muted-foreground text-sm">{t("saved.empty.description")}</p>
		<Button
			href={getRelativeLocaleUrl("en", "catalog")}
			preset="solid"
		>
			{t("saved.empty.cta")}
		</Button>
	</div>

	<div class="columns-1 gap-8 px-5 sm:columns-2 lg:columns-3">
		{cards.map((card) => (
				<div data-saved-item={card.id} hidden class="mb-8 break-inside-avoid">
					<CatalogCard card={card} />
				</div>
			))}
	</div>

</Layout>

<script>
const STORAGE_KEY = "catalog:saved";

function getSaved(): Set<string> {
	try {
		const raw = localStorage.getItem(STORAGE_KEY);
		const parsed = raw ? JSON.parse(raw) : [];
		return new Set(Array.isArray(parsed) ? parsed : []);
	} catch {
		return new Set();
	}
}

function render() {
	const saved = getSaved();
	const items = document.querySelectorAll<HTMLElement>("[data-saved-item]");
	let visible = 0;

	for (const item of items) {
		const isSaved = saved.has(item.dataset.savedItem ?? "");
		item.toggleAttribute("hidden", !isSaved);
		if (isSaved) visible += 1;
	}

	document
		.querySelector("[data-saved-empty]")
		?.toggleAttribute("hidden", visible > 0);

	const count = document.querySelector("[data-saved-count]");
	if (count) count.textContent = String(visible);
}

render();

window.addEventListener("catalog:saved-change", render);
</script>
