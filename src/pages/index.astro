---
import { getCollection } from "astro:content";
import CatalogStats from "@/components/CatalogStats/CatalogStats.astro";
import MainTitle from "@/components/MainTitle.astro";
import FAQ from "@/components/partials/FAQ.astro";
import Features from "@/components/partials/Features.astro";
import Footer from "@/components/partials/Footer.astro";
import Header from "@/components/partials/Header.astro";
import LogoMarquee from "@/components/partials/LogoMarquee.astro";
import LogoStack from "@/components/partials/LogoStack.astro";
import Quote from "@/components/partials/Quote.astro";
import VideoShowcase from "@/components/partials/VideoShowcase.astro";
import { buildAlternates, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const t = useTranslations("ru");
const cards = await getCollection("cards");
---

<Layout
	title={t("meta.title")}
	description={t("meta.description")}
	htmlLang="ru"
	alternates={buildAlternates(Astro.url.pathname)}
	markdownURL="/index.md"
>
	<Header locale="ru" />
	<LogoStack />
	<MainTitle locale="ru" />
	<VideoShowcase locale="ru" />
	<LogoMarquee locale="ru" cards={cards} />
	<Features />
	<Quote
		quote="Being able to pull Mobbin's patterns, knowledge, and images directly into my brainstorming sessions with Claude is incredible. It's something I've always had to do manually until now."
		name="Имя автора"
		role="Должность, компания"
	/>
	<CatalogStats locale="ru" cards={cards} />
	<FAQ />
	<Footer locale="ru" />
</Layout>
