---
import { getEntry, render } from "astro:content";
import MDX from "@/layouts/MDX.astro";

const entry = await getEntry("pages", "sources");
if (!entry) throw new Error("pages/sources отсутствует в коллекции");

const { Content } = await render(entry);
---

<MDX locale="ru" {...entry.data}>
	<Content />
</MDX>
